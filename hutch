#!/usr/bin/env bash
# hutch: a coding agent (opencode or Claude Code) does one bounded task in an isolated container; the host agent briefs and verifies.
#   hutch status                                   machine and project state; start here (exit 3: project not set up, 4: machine not set up)
#   hutch init [--in-repo]                         create this project's config from the template (~/.hutch/projects/<name>, or <repo>/.hutch)
#   hutch build                                    build the base and project images, pull the gate, create the networks
#   hutch new <task> [<allow> <brief>] [options]   clone base branch; options: --allow <glob> --allow-file <f> --brief <f> --opened <f> --context <spec>
#   hutch run [options] <task>                     run agent with watchdog; options: --context <spec> --max-turns <N> --max-timeout <S> --loop-threshold <N>
#   hutch batch [options] <task1> <task2>...       run tasks concurrently; options: --max-parallel <N> --max-turns <N> --max-timeout <S> --loop-threshold <N>
#   hutch say <task> <message>                     follow-up message (opencode: after the run ends; claude: during the run)
#   hutch shell <task>                             interactive agent session in the sandbox
#   hutch export <task>                            write the task branch as a git bundle
#   hutch verify [options] <task>                  check bundle offline; options: --soft-scope|--strict-scope --allow-tests --allow <glob> --allow-file <f>
#   hutch report <task>                            the task's model, usage, commits, verify status and test changes (report.md)
#   hutch ls                                       this project's tasks: age, run state, verify status, commits on the host, model
#   hutch rm <task>                                remove a task workspace, its output and its ref
#   hutch smoke|isolation <task>                   one-line model call | egress, mount and capability probes
#   hutch models                                   the model chosen per HUTCH_KIND and the skipped models
#   hutch needs-pro <task>                         why a task needs a strong model (exit 1: it does not)
#   Exit codes: 0 ok, 3 project not set up, 4 machine/cache missing, 42 NEEDS_SCOPE, 43 LOOP_DETECTED, 44 MAX_TURNS, 124 timeout.
# Agents: read AGENTS.md next to this script before using it.
# Path rules match unquoted globs on purpose (SC2053); the isolation probe is a literal script (SC2016).
# shellcheck disable=SC2053,SC2016,SC2012
set -euo pipefail

HUTCH_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
HUTCH_HOME="${HUTCH_HOME:-${HOME}/.hutch}"
BASE_IMAGE=hutch-base:latest
# The gate: nginx, unprivileged, pinned by digest. It holds the provider key for one sandbox command and forwards only
# the provider's API paths; the sandbox has no other way out.
GATE_IMAGE=nginxinc/nginx-unprivileged:1.27.5-alpine@sha256:65e3e85dbaed8ba248841d9d58a899b6197106c23cb0ff1a132b7bfe0547e4c0
NET_INTERNAL=hutch-internal
NET_EGRESS=hutch-egress
# Kinds in the model tables that count as strong models for the pro-paths rule.
PRO_KINDS="design concurrency"

die() { echo "hutch: $*" >&2; exit 1; }
rand_hex() { od -An -tx1 -N"$1" /dev/urandom | tr -d ' \n'; }
gen_proxy_token() { echo "hutch-proxy-$(rand_hex 16)"; }

# ---- provider, agent and model -------------------------------------------------------------------------------

# kv_get prints the value of key $2 from key=value file $1 (the file is read, never executed; the first line wins).
kv_get() {
  awk -v k="$2" 'index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }' "$1"
}

# setup_provider reads providers/<name>.conf, or ~/.hutch/providers/<name>.conf first, for HUTCH_PROVIDER (default
# opencode), and checks the values that end up in the gate's nginx configuration.
setup_provider() {
  local file p
  PROVIDER="${HUTCH_PROVIDER:-opencode}"
  [[ "$PROVIDER" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "HUTCH_PROVIDER must match [a-z0-9][a-z0-9-]*"
  file="${HUTCH_HOME}/providers/${PROVIDER}.conf"
  [[ -f "$file" ]] || file="${HUTCH_DIR}/providers/${PROVIDER}.conf"
  [[ -f "$file" ]] || die "no provider '$PROVIDER': add ${HUTCH_HOME}/providers/${PROVIDER}.conf (see ${HUTCH_DIR}/providers)"
  UPSTREAM="$(kv_get "$file" upstream)"
  [[ "$UPSTREAM" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?$ ]] ||
    die "$file: upstream must be https://host[:port] with no path, got '$UPSTREAM'"
  KEY_ITEM="${HUTCH_KEY_ITEM:-$(kv_get "$file" key_item)}"
  [[ -n "$KEY_ITEM" ]] || die "$file: key_item is empty"
  PATHS="$(kv_get "$file" paths)"
  [[ -n "$PATHS" ]] || die "$file: paths is empty"
  for p in $PATHS; do [[ "$p" =~ ^/[A-Za-z0-9._/-]*$ ]] || die "$file: paths must be /path prefixes, got '$p'"; done
  CLAUDE_BASE="$(kv_get "$file" claude_base)"
  OPENCODE_BASE="$(kv_get "$file" opencode_base)"
  OPENCODE_PROVIDER="$(kv_get "$file" opencode_provider)"
  for p in "$CLAUDE_BASE" "$OPENCODE_BASE"; do
    [[ -z "$p" || "$p" =~ ^/[A-Za-z0-9._/-]*$ ]] || die "$file: claude_base and opencode_base must be /paths"
  done
  [[ -z "$OPENCODE_PROVIDER" || "$OPENCODE_PROVIDER" =~ ^[a-z0-9-]+$ ]] || die "$file: opencode_provider is not an id"
  COMPACT_WINDOW="${HUTCH_COMPACT_WINDOW:-$(kv_get "$file" compact_window)}"
  p="$(kv_get "$file" models)"
  [[ -z "$p" || "$p" == /* ]] || p="$(dirname "$file")/$p"
  [[ -n "$p" ]] || p="${HUTCH_DIR}/models/${PROVIDER}.tsv"
  MODELS_FILE="${HUTCH_MODELS:-$(cd "$(dirname "$p")" 2>/dev/null && pwd)/$(basename "$p")}"
  AGENT="${HUTCH_AGENT:-opencode}"
  case "$AGENT" in
    opencode) [[ -n "$OPENCODE_PROVIDER" && -n "$OPENCODE_BASE" ]] ||
      die "provider $PROVIDER has no opencode_provider / opencode_base: use HUTCH_AGENT=claude" ;;
    claude) [[ -n "$CLAUDE_BASE" ]] || die "provider $PROVIDER has no claude_base: use HUTCH_AGENT=opencode" ;;
    *) die "HUTCH_AGENT must be opencode or claude" ;;
  esac
  KIND="${HUTCH_KIND:-}"
  [[ -z "$KIND" && "${HUTCH_PHASE:-}" == design ]] && KIND=design
  MODEL="${HUTCH_MODEL:-}"
  SMALL_MODEL="${HUTCH_SMALL_MODEL:-}"
}

# kinds lists the HUTCH_KIND values the model table defines.
kinds() { awk -F'\t' '!/^#/ && NF > 1 && $1 != "small" { printf "%s%s", sep, $1; sep = ", " }' "$MODELS_FILE"; }

# pick_model prints the first model of a table row that ~/.hutch/skip does not list (one model per line there).
pick_model() {
  local row m
  row="$(awk -F'\t' -v k="$1" '$1 == k { print $2 }' "$MODELS_FILE")"
  [[ -n "$row" ]] || die "$(basename "$MODELS_FILE") has no kind '$1' ($(kinds))"
  for m in $row; do
    grep -qxF "$m" "${HUTCH_HOME}/skip" 2>/dev/null || { echo "$m"; return; }
  done
  die "every model for '$1' is in ${HUTCH_HOME}/skip"
}

# need_models resolves MODEL and SMALL_MODEL for a command that talks to a model.
need_models() {
  if [[ -z "$MODEL" ]]; then
    [[ -n "$KIND" ]] || die "set HUTCH_KIND ($(kinds)) or HUTCH_MODEL"
    MODEL="$(pick_model "$KIND")"
  fi
  [[ -n "$SMALL_MODEL" ]] || SMALL_MODEL="$(pick_model small)"
}

# api_key prints the provider key: HUTCH_API_KEY, else the macOS keychain, else the Secret Service (Linux).
api_key() {
  if [[ -n "${HUTCH_API_KEY:-}" ]]; then echo "$HUTCH_API_KEY"; return; fi
  if command -v security >/dev/null; then
    security find-generic-password -s "$KEY_ITEM" -w 2>/dev/null && return
  elif command -v secret-tool >/dev/null; then
    secret-tool lookup service "$KEY_ITEM" 2>/dev/null && return
  fi
  die "no API key: store it as '$KEY_ITEM' (AGENTS.md, Machine setup) or set HUTCH_API_KEY"
}

have_key() {
  [[ -n "${HUTCH_API_KEY:-}" ]] && return 0
  if command -v security >/dev/null; then security find-generic-password -s "$KEY_ITEM" >/dev/null 2>&1; return; fi
  command -v secret-tool >/dev/null && [[ -n "$(secret-tool lookup service "$KEY_ITEM" 2>/dev/null)" ]]
}

# ---- project ---------------------------------------------------------------------------------------------------

# conf_get prints the value of key $1 from the project config.
conf_get() { kv_get "$CONF/config" "$1"; }

slug() { echo "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-\n' '-'; }

# resolve_project sets REPO (the main checkout, also from a worktree), NAME and CONF; CONF is empty when not set up.
resolve_project() {
  local common
  CONF=""
  if [[ -n "${HUTCH_PROJECT:-}" ]]; then
    NAME="$(slug "$HUTCH_PROJECT")"
    [[ -f "${HUTCH_HOME}/projects/${NAME}/config" ]] && CONF="${HUTCH_HOME}/projects/${NAME}"
    REPO=""
    [[ -n "$CONF" ]] && REPO="$(conf_get repo)"
    [[ -n "$REPO" ]] || die "HUTCH_PROJECT=$NAME needs ${HUTCH_HOME}/projects/${NAME}/config with a repo= line"
  else
    common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ||
      die "not inside a git repository (or set HUTCH_PROJECT)"
    REPO="$(dirname "$common")"
    NAME="$(slug "$(basename "$REPO")")"
    if [[ -f "$REPO/.hutch/config" ]]; then CONF="$REPO/.hutch"
    elif [[ -f "${HUTCH_HOME}/projects/${NAME}/config" ]]; then CONF="${HUTCH_HOME}/projects/${NAME}"; fi
  fi
  if [[ -n "$CONF" ]]; then
    local n; n="$(conf_get name)"
    [[ -n "$n" ]] && NAME="$n"
    [[ "$NAME" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "project name '$NAME' must match [a-z0-9][a-z0-9-]*"
  fi
  STATE="${HUTCH_HOME}/state/${NAME}"
  PROJECT_IMAGE="hutch-${NAME}:latest"
  CACHE_VOLUME="hutch-${NAME}-cache"
}

# try_resolve resolves the project when that works and fails quietly otherwise (resolve_project exits on errors).
try_resolve() { (resolve_project) >/dev/null 2>&1 && resolve_project; }

need_project() {
  resolve_project
  [[ -n "$CONF" ]] && return
  echo "hutch: project '$NAME' ($REPO) is not set up: there is no $REPO/.hutch/config or ${HUTCH_HOME}/projects/$NAME/config." >&2
  echo "Agents: stop here and follow \"Project setup\" in ${HUTCH_DIR}/AGENTS.md, asking the user its questions, before any other hutch command." >&2
  exit 3
}

base_branch() { local b; b="$(conf_get base_branch)"; echo "${b:-main}"; }

task_dir() { echo "${STATE}/work/$1"; }
out_dir() { echo "${STATE}/out/$1"; }

need_task() {
  [[ -n "${1:-}" && "$1" =~ ^[a-z0-9-]+$ ]] || die "task name must match [a-z0-9-]+"
  [[ -d "$(task_dir "$1")/repo" ]] || die "no workspace for $1 (hutch new)"
}

# patterns prints the non-comment lines of a pattern file; a missing file prints nothing.
patterns() { [[ -f "$1" ]] || return 0; grep -v -e '^[[:space:]]*$' -e '^#' "$1" || true; }

# ---- path rules ------------------------------------------------------------------------------------------------

# Paths the agent may never change, whatever the project or task says: the project's hutch config itself, git
# metadata, CI configs, dependency manifests/lockfiles, build scripts, env/secret files, and every .gitattributes
# (because verify checks a git archive of the task branch and export-ignore in any directory would hide files).
ALWAYS_PROTECTED='.hutch/*
.git
.git/*
*/.git
*/.git/*
.gitmodules
*/.gitmodules
.gitattributes
*/.gitattributes
.github/*
.gitlab-ci.yml
*/.gitlab-ci.yml
.circleci/*
.buildkite/*
Jenkinsfile
*/Jenkinsfile
.travis.yml
azure-pipelines.yml
package.json
*/package.json
package-lock.json
*/package-lock.json
pnpm-lock.yaml
*/pnpm-lock.yaml
yarn.lock
*/yarn.lock
bun.lock
*/bun.lock
bun.lockb
*/bun.lockb
go.mod
*/go.mod
go.sum
*/go.sum
Cargo.toml
*/Cargo.toml
Cargo.lock
*/Cargo.lock
pyproject.toml
*/pyproject.toml
poetry.lock
*/poetry.lock
uv.lock
*/uv.lock
Pipfile
Pipfile.lock
requirements*.txt
*/requirements*.txt
Gemfile
Gemfile.lock
composer.json
composer.lock
Makefile
*/Makefile
GNUmakefile
*/GNUmakefile
Dockerfile
*/Dockerfile
Dockerfile.*
*/Dockerfile.*
*.Dockerfile
compose.yaml
compose.yml
docker-compose*.yml
docker-compose*.yaml
.env
.env.*
.env*
*/.env
*/.env.*
*/.env*'

EXTRA_ALLOW=""

# opened succeeds when protected pattern $1 is openable in this project and the task's opened file lists it.
opened() {
  local p="$1" o
  [[ -f "${OPENED_FILE:-}" ]] || return 1
  grep -qxF -- "$p" "$OPENED_FILE" || return 1
  while IFS= read -r o; do [[ "$p" == "$o" ]] && return 0; done < <(patterns "$CONF/openable")
  return 1
}

protected() {
  local f="$1" p
  while IFS= read -r p; do [[ -n "$p" && "$f" == $p ]] && return 0; done <<<"$ALWAYS_PROTECTED"
  while IFS= read -r p; do
    [[ "$f" == $p ]] && ! opened "$p" && return 0
  done < <(patterns "$CONF/protected")
  return 1
}

allowed() {
  local f="$1" p
  if [[ -f "${ALLOW_FILE:-}" ]]; then
    while IFS= read -r p; do [[ "$f" == $p ]] && return 0; done < <(patterns "$ALLOW_FILE")
  fi
  if [[ -n "${EXTRA_ALLOW:-}" ]]; then
    while IFS= read -r p; do [[ -n "$p" && "$f" == $p ]] && return 0; done <<<"$EXTRA_ALLOW"
  fi
  return 1
}

scope_mode() {
  local m="${1:-}"
  if [[ -z "$m" ]]; then
    if [[ "${HUTCH_STRICT_SCOPE:-}" == 1 ]]; then m=strict
    elif [[ "${HUTCH_SOFT_SCOPE:-}" == 1 ]]; then m=soft
    else m="$(conf_get scope_mode)"; fi
  fi
  m="${m:-soft}"
  [[ "$m" == soft || "$m" == strict ]] || die "scope_mode must be soft or strict, got '$m'"
  echo "$m"
}

# needs_pro prints why a task (allow file $1, opened file $2) needs a strong model and succeeds. The rule is on only
# when the project has a pro-paths file. An allow pattern needs one when it and a pro-paths line match either way, so
# both a narrow allow inside a sensitive area and a broad allow that covers one are caught.
needs_pro() {
  local allow="$1" opened_file="$2" p g
  [[ -n "$(patterns "$CONF/pro-paths")" ]] || return 1
  [[ -s "$opened_file" ]] && { echo "opens protected paths ($(tr '\n' ' ' <"$opened_file"))"; return 0; }
  while IFS= read -r p; do
    while IFS= read -r g; do
      if [[ "$p" == $g || "$g" == $p ]]; then echo "may change sensitive code ($p, pro-paths: $g)"; return 0; fi
    done < <(patterns "$CONF/pro-paths")
  done < <(patterns "$allow")
  return 1
}

# Test files when the project config has no tests= pattern (an ERE over repository paths).
DEFAULT_TESTS='(^|/)(tests?|__tests__|specs?)/|[._-](test|spec)\.[A-Za-z0-9]+$|_test\.go$|(^|/)test_[^/]*\.py$'
# Added lines that skip or focus tests, in the common frameworks.
SKIP_MARKERS='\.(skip|only|todo)\(|(^|[^A-Za-z0-9_])(xit|xdescribe|xtest|fit|fdescribe)\(|t\.Skip|@pytest\.mark\.(skip|xfail)|@unittest\.skip|@Disabled|@Ignore|#\[ignore\]'

test_regex() {
  local re
  re="$(conf_get tests)"
  echo "${re:-$DEFAULT_TESTS}"
}

is_test_file() {
  grep -qE -- "$(test_regex)" <<<"$1"
}

# is_preexisting_test succeeds when $2 is a test path that already existed on base commit $1.
is_preexisting_test() {
  local base="$1" f="$2"
  is_test_file "$f" && git -C "$REPO" cat-file -e "${base}:${f}" 2>/dev/null
}

# test_changes names what a task did to the project's tests between commits $1 and $2: deleted test files, lines
# removed from existing ones, added skip or focus markers, and new test files. A cheap model that cannot make a test
# pass may weaken it instead, and the checks would still pass. With tests_policy=append-only any of those fails.
test_changes() {
  local base="$1" ref="$2" re policy st f n skips bad=0
  re="$(test_regex)"
  policy="$(conf_get tests_policy)"; policy="${policy:-report}"
  [[ "$policy" == report || "$policy" == append-only ]] || die "tests_policy must be report or append-only"
  while IFS=$'\t' read -r st f; do
    if [[ -z "$f" ]] || ! grep -qE -- "$re" <<<"$f"; then continue; fi
    case "$st" in
      D) echo "DELETED $f"; bad=1; continue ;;
      A) echo "new $f" ;;
      *) n="$(git -C "$REPO" diff --numstat --no-renames "$base" "$ref" -- "$f" | awk '{ print $1 " " $2 }')"
         if [[ "${n#* }" != 0 ]]; then echo "EDITED $f (-${n#* })"; bad=1; else echo "extended $f (+${n% *})"; fi ;;
    esac
    skips="$(git -C "$REPO" diff -U0 --no-renames "$base" "$ref" -- "$f" | grep -E '^\+' | grep -v '^+++' |
      grep -E -- "$SKIP_MARKERS" || true)"
    if [[ -n "$skips" ]]; then
      while IFS= read -r n; do echo "SKIP $f: ${n#+}"; done <<<"$skips"
      bad=1
    fi
  done < <(git -C "$REPO" diff --name-status --no-renames "$base" "$ref")
  [[ $bad -eq 1 ]] || echo "(no changes to existing tests)"
  [[ "$policy" == append-only && $bad -eq 1 ]] && return 1
  return 0
}

need_pro_kind() {
  local dir reason k pro=" "
  dir="$(task_dir "$1")"
  reason="$(needs_pro "$dir/allow" "$dir/opened")" || return 0
  for k in $PRO_KINDS; do pro+="$(awk -F'\t' -v k="$k" '$1 == k { print $2 }' "$MODELS_FILE") "; done
  [[ "$pro" == *" $MODEL "* ]] && return 0
  die "task $1 $reason; run it with HUTCH_KIND set to one of: $PRO_KINDS (a strong model)"
}

# ---- runtime (Docker) ------------------------------------------------------------------------------------------

need_docker() { docker info >/dev/null 2>&1 || die "docker is not running"; }

# docker_runtimes prints the runtimes the Docker daemon knows, one per line.
docker_runtimes() { docker info --format '{{range $k, $v := .Runtimes}}{{println $k}}{{end}}' 2>/dev/null; }

need_image() { docker image inspect "$1" >/dev/null 2>&1 || die "image $1 is missing; run hutch build"; }

# gate_location emits one nginx location block that authenticates the sandbox's per-run HUTCH_PROXY_TOKEN, blocks
# path traversal and query-param credential smuggling, injects the host's real provider key (${HUTCH_KEY}), and strips
# alternative auth headers so the sandbox can never use another account on the upstream host.
gate_location() {
  local matcher="$1" host="$2"
  printf '%s\n' \
    "  location $matcher {" \
    '    if ($hutch_token_ok = 0) { return 403 "hutch gate: invalid proxy token\n"; }' \
    '    if ($request_uri ~* "(%2e|%2f|%5c|\.\.)") { return 403 "hutch gate: invalid path\n"; }' \
    '    if ($args ~* "(^|&)(api_?key|key|token|auth)=") { return 403 "hutch gate: credential query param not allowed\n"; }' \
    "    proxy_pass $UPSTREAM;" \
    "    proxy_ssl_server_name on;" \
    "    proxy_ssl_name ${host%%:*};" \
    "    proxy_ssl_verify on;" \
    "    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;" \
    "    proxy_set_header Host $host;" \
    '    proxy_set_header Authorization "Bearer ${HUTCH_KEY}";' \
    '    proxy_set_header x-api-key "${HUTCH_KEY}";' \
    '    proxy_set_header api-key "";' \
    '    proxy_set_header x-auth-token "";' \
    '    proxy_set_header x-goog-api-key "";' \
    '    proxy_set_header Proxy-Authorization "";' \
    '    proxy_set_header Cookie "";' \
    "    proxy_http_version 1.1;" \
    "    proxy_buffering off;" \
    "    proxy_request_buffering off;" \
    "    proxy_read_timeout 900s;" \
    "  }"
}

# gate_conf prints the gate's nginx template: per-run proxy token maps, one location per allowed path prefix
# forwarded to the upstream over verified TLS with the host key injected from ${HUTCH_KEY}, and 403 for all else.
gate_conf() {
  local host="${UPSTREAM#https://}" p
  printf '%s\n' \
    'log_format hutch_gate '"'"'$time_iso8601 $request_method $request_uri -> $status upstream=$upstream_status'"'"';' \
    'map_hash_bucket_size 128;' \
    'map $http_authorization $hutch_auth_state {' \
    '  ""                             empty;' \
    '  "Bearer ${HUTCH_PROXY_TOKEN}"  valid;' \
    '  default                        invalid;' \
    '}' \
    'map $http_x_api_key $hutch_xkey_state {' \
    '  ""                             empty;' \
    '  "${HUTCH_PROXY_TOKEN}"         valid;' \
    '  default                        invalid;' \
    '}' \
    'map "$hutch_auth_state:$hutch_xkey_state" $hutch_token_ok {' \
    '  "valid:valid"  1;' \
    '  "valid:empty"  1;' \
    '  "empty:valid"  1;' \
    '  default        0;' \
    '}' \
    'server {' \
    '  listen 8080;' \
    '  access_log /dev/stdout hutch_gate;' \
    '  client_max_body_size 64m;' \
    '  location = /hutch-gate-health { access_log off; return 200 "ok\n"; }'
  for p in $PATHS; do
    if [[ "$p" == */ ]]; then
      gate_location "^~ $p" "$host"
    else
      gate_location "= $p" "$host"
      gate_location "^~ ${p}/" "$host"
    fi
  done
  printf '%s\n' '  location / { return 403 "hutch gate: path not allowed\n"; }' '}'
}

# gate_up starts gate $1 for one sandbox command of task $4 with the provider key and per-run proxy token $5, writes
# its template to file $2, and waits until it answers. gate_down (also run on exit) appends its access log to file $3
# and removes it.
gate_up() {
  local name="$1" conf="$2" key proxy_token _
  proxy_token="${5:-$(gen_proxy_token)}"
  key="$(api_key)"
  if ! python3 -I -c 'import sys; k = sys.argv[1]; sys.exit(0 if k and all(32 < ord(c) < 127 and c not in "\"\\;" for c in k) else 1)' "$key"; then
    die "API key contains unsafe characters for gate configuration"
  fi
  gate_conf >"$conf"
  GATE_NAME="$name"; GATE_LOG="$3"
  HUTCH_KEY="$key" HUTCH_PROXY_TOKEN="$proxy_token" docker run -d --rm --name "$name" --network "$NET_EGRESS" --cap-drop ALL \
    --security-opt no-new-privileges --read-only --tmpfs /tmp:mode=1777 --tmpfs /etc/nginx/conf.d:mode=1777 \
    --memory 256m --pids-limit 64 --label "hutch.project=$NAME" --label "hutch.task=$4" -e HUTCH_KEY -e HUTCH_PROXY_TOKEN \
    -v "$conf:/etc/nginx/templates/default.conf.template:ro" "$GATE_IMAGE" >/dev/null
  docker network connect "$NET_INTERNAL" "$name"
  GATE_IP="$(docker inspect -f "{{(index .NetworkSettings.Networks \"$NET_INTERNAL\").IPAddress}}" "$name")"
  [[ "$GATE_IP" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "the gate $name has no address on $NET_INTERNAL ('$GATE_IP')"
  for _ in $(seq 1 50); do
    docker exec "$name" wget -q -O /dev/null http://127.0.0.1:8080/hutch-gate-health 2>/dev/null && return 0
    sleep 0.2
  done
  docker logs "$name" >&2 2>&1 || true
  die "the gate $name did not start (log above)"
}

gate_down() {
  [[ -n "${GATE_NAME:-}" ]] || return 0
  docker logs "$GATE_NAME" >>"$GATE_LOG" 2>&1 || true
  docker rm -f "$GATE_NAME" >/dev/null 2>&1 || true
  GATE_NAME=""
}

# ---- copy-on-write dependency and build cache overlays ---------------------------------------------------------

OVERLAY_DOCKER_ARGS=()
OVERLAY_COW_PAIRS=()
OVERLAY_VOLUMES=()
OVERLAY_TMP_DIRS=()

cache_overlays_spec() {
  local s="${HUTCH_CACHE_OVERLAYS:-}"
  [[ -n "$s" ]] || s="$(conf_get cache_overlays)"
  echo "$s"
}

resolve_overlay_mode() {
  local m="${HUTCH_CACHE_OVERLAY_MODE:-}"
  [[ -n "$m" ]] || m="$(conf_get cache_overlay_mode)"
  m="${m:-auto}"
  case "$m" in
    auto)
      if [[ "$(uname -s)" == Linux ]]; then echo docker-overlay
      else echo cow-tmpfs; fi ;;
    docker-overlay|cow-tmpfs|ro) echo "$m" ;;
    *) die "cache_overlay_mode must be auto, docker-overlay, cow-tmpfs, or ro; got '$m'" ;;
  esac
}

resolve_overlay_host() {
  local p="$1"
  case "$p" in
    \~/*) echo "${HOME}/${p#\~/}" ;;
    /*) echo "$p" ;;
    *) echo "${REPO}/${p}" ;;
  esac
}

validate_overlay_entry() {
  local entry="$1" host ctr
  [[ "$entry" == *:* ]] || die "cache_overlays entry must be host_path:container_path, got '$entry'"
  host="${entry%%:*}"; ctr="${entry#*:}"
  [[ -n "$host" && -n "$ctr" && "$ctr" != *:* ]] || die "invalid cache_overlays entry: '$entry'"
  [[ "$host" != *,* ]] || die "cache_overlays host path cannot contain ',': '$host'"
  [[ "$ctr" =~ ^/[A-Za-z0-9._/@+-]+(/[A-Za-z0-9._/@+-]+)*$ ]] ||
    die "cache_overlays container path must be a safe absolute path, got '$ctr'"
  [[ "$ctr" != */.. && "$ctr" != */../* ]] || die "cache_overlays container path cannot contain '..': '$ctr'"
  case "$ctr" in
    /|/work|/out|/task|/etc|/etc/*|/usr|/usr/*|/bin|/bin/*|/lib|/lib/*|/proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/tmp|/.hutch-ro|/.hutch-ro/*)
      die "cache_overlays container path '$ctr' targets a reserved path" ;;
  esac
}

overlay_up() {
  local run_tag="$1" spec raw_mode mode uid gid idx=0 entry host_raw host_dir ctr_path ov_base vol m
  OVERLAY_DOCKER_ARGS=(); OVERLAY_COW_PAIRS=(); OVERLAY_VOLUMES=(); OVERLAY_TMP_DIRS=()
  spec="$(cache_overlays_spec)"
  m="$(conf_get cache_mount)"
  [[ -n "$spec" || -n "$m" ]] || return 0
  raw_mode="${HUTCH_CACHE_OVERLAY_MODE:-$(conf_get cache_overlay_mode)}"
  raw_mode="${raw_mode:-auto}"
  mode="$(resolve_overlay_mode)"
  uid="$(id -u)"; gid="$(id -g)"
  for entry in $spec; do
    validate_overlay_entry "$entry"
    host_raw="${entry%%:*}"; ctr_path="${entry#*:}"
    host_dir="$(resolve_overlay_host "$host_raw")"
    [[ -d "$host_dir" ]] || die "cache overlay source missing: $host_dir (check cache_overlays)"
    if [[ "$mode" == docker-overlay ]]; then
      ov_base="${STATE}/tmp/ov-${run_tag}-${idx}"
      mkdir -p "$ov_base/upper" "$ov_base/work"
      vol="hutch-ov-${NAME}-${run_tag}-${idx}"
      if docker volume create --driver local --opt type=overlay --opt device=overlay \
        --opt "o=lowerdir=${host_dir},upperdir=${ov_base}/upper,workdir=${ov_base}/work" "$vol" >/dev/null 2>&1; then
        OVERLAY_VOLUMES+=("$vol")
        OVERLAY_TMP_DIRS+=("$ov_base")
        OVERLAY_DOCKER_ARGS+=(-v "${vol}:${ctr_path}")
      else
        /bin/rm -rf "$ov_base"
        [[ "$raw_mode" == auto ]] || die "failed to create overlay volume $vol for $host_dir"
        OVERLAY_DOCKER_ARGS+=(-v "${host_dir}:/.hutch-ro/ov${idx}:ro" --tmpfs "${ctr_path}:exec,uid=${uid},gid=${gid},mode=0755")
        OVERLAY_COW_PAIRS+=("/.hutch-ro/ov${idx}:${ctr_path}")
      fi
    elif [[ "$mode" == cow-tmpfs ]]; then
      OVERLAY_DOCKER_ARGS+=(-v "${host_dir}:/.hutch-ro/ov${idx}:ro" --tmpfs "${ctr_path}:exec,uid=${uid},gid=${gid},mode=0755")
      OVERLAY_COW_PAIRS+=("/.hutch-ro/ov${idx}:${ctr_path}")
    else
      OVERLAY_DOCKER_ARGS+=(-v "${host_dir}:${ctr_path}:ro")
    fi
    idx=$((idx + 1))
  done
  if [[ -n "$m" ]]; then
    validate_overlay_entry "volume:$m"
    if [[ "$mode" == ro ]]; then
      OVERLAY_DOCKER_ARGS+=(-v "${CACHE_VOLUME}:${m}:ro")
    else
      OVERLAY_DOCKER_ARGS+=(-v "${CACHE_VOLUME}:/.hutch-ro/cache:ro" --tmpfs "${m}:exec,uid=${uid},gid=${gid},mode=0755")
      OVERLAY_COW_PAIRS+=("/.hutch-ro/cache:${m}")
    fi
  fi
}

overlay_down() {
  local vol d
  if [[ ${#OVERLAY_VOLUMES[@]} -gt 0 ]]; then
    for vol in "${OVERLAY_VOLUMES[@]}"; do docker volume rm -f "$vol" >/dev/null 2>&1 || true; done
  fi
  if [[ ${#OVERLAY_TMP_DIRS[@]} -gt 0 ]]; then
    for d in "${OVERLAY_TMP_DIRS[@]}"; do /bin/rm -rf "$d"; done
  fi
  OVERLAY_DOCKER_ARGS=(); OVERLAY_COW_PAIRS=(); OVERLAY_VOLUMES=(); OVERLAY_TMP_DIRS=()
}

overlay_cow_env() {
  local out="" p
  for p in "${OVERLAY_COW_PAIRS[@]}"; do out+="${out:+|}${p}"; done
  echo "$out"
}

overlay_cow_script() {
  cat <<'EOF'
IFS='|' read -ra _hutch_pairs <<< "${HUTCH_COW_MOUNTS:-}"
for _hutch_p in "${_hutch_pairs[@]}"; do
  _hutch_src="${_hutch_p%%:*}"; _hutch_dst="${_hutch_p#*:}"
  if [ -d "$_hutch_src" ] && [ -n "$(ls -A "$_hutch_src" 2>/dev/null)" ]; then
    mkdir -p "$_hutch_dst"
    cp -rPs "$_hutch_src/." "$_hutch_dst/" 2>/dev/null || cp -r "$_hutch_src/." "$_hutch_dst/"
  fi
done
exec "$@"
EOF
}

cleanup_runtime() {
  gate_down
  overlay_down
}

# limit_args prints the process and memory limits for every container that runs the agent's code.
limit_args() {
  local pids mem
  pids="${HUTCH_PIDS:-$(conf_get pids)}"; mem="${HUTCH_MEMORY:-$(conf_get memory)}"
  echo "--pids-limit ${pids:-2048} --memory ${mem:-12g}"
}

# setup_runtime sets RUNTIME from HUTCH_RUNTIME or the config's runtime= (runsc: gVisor, a user-space kernel between
# the agent's code and the host's); empty is Docker's default runtime. Every container that runs the agent's code or
# reads its repository passes it; the gate does not (it runs only nginx). It is checked here, outside any command
# substitution, so a bad value stops hutch instead of silently falling back to the default runtime.
setup_runtime() {
  RUNTIME="${HUTCH_RUNTIME:-$(conf_get runtime)}"
  [[ -z "$RUNTIME" || "$RUNTIME" =~ ^[A-Za-z0-9._-]+$ ]] ||
    die "HUTCH_RUNTIME / runtime must be a Docker runtime name, got '$RUNTIME'"
}

# seconds prints a time limit: environment variable $1, else config key $2, else default $3.
seconds() {
  local v="${!1:-}"
  [[ -n "$v" ]] || v="$(conf_get "$2")"
  v="${v:-$3}"
  [[ "$v" =~ ^[0-9]+$ ]] || die "$1 / $2 must be whole seconds, got '$v'"
  echo "$v"
}
run_timeout() { seconds HUTCH_RUN_TIMEOUT run_timeout 3600; }
verify_timeout() { seconds HUTCH_VERIFY_TIMEOUT verify_timeout 1800; }

# TIMED_OUT is the exit code of coreutils timeout when the limit is reached; the agent and the checks run under it
# inside the container, so a stuck run or check ends instead of holding the sandbox and the model quota.
TIMED_OUT=124
EXIT_NEEDS_SCOPE=42
EXIT_LOOP_DETECTED=43
EXIT_MAX_TURNS=44

# opencode_json prints the opencode configuration for one run: the provider's base URL points at the gate
# and uses the per-run proxy token ($2), never the real provider key.
opencode_json() {
  printf '%s\n' '{' \
    '  "$schema": "https://opencode.ai/config.json",' \
    '  "update": "disable",' \
    '  "share": "disabled",' \
    "  \"model\": \"$OPENCODE_PROVIDER/$MODEL\"," \
    "  \"small_model\": \"$OPENCODE_PROVIDER/$SMALL_MODEL\"," \
    "  \"agent\": { \"general\": { \"model\": \"$OPENCODE_PROVIDER/$MODEL\" }, \"explore\": { \"model\": \"$OPENCODE_PROVIDER/$SMALL_MODEL\" } }," \
    "  \"provider\": { \"$OPENCODE_PROVIDER\": { \"options\": { \"baseURL\": \"$1\", \"apiKey\": \"$2\" } } }" \
    '}'
}

# sandbox runs SANDBOX_CMD in the project image: internal network with no route out, the gate as the only peer (it
# holds the key), no capabilities, only the task's files mounted. Extra docker flags come in "$@".
sandbox() {
  local task="$1"; shift
  local dir out gate url probe proxy_token agent_args extra
  dir="$(task_dir "$task")"; out="$(out_dir "$task")"
  [[ -f "$CONF/primer.md" ]] || die "missing $CONF/primer.md"
  # /out is a subdirectory: the sandbox can put symlinks in any directory it writes, so the files hutch writes
  # (logs, exit code, reports) live in the parent, which no container sees.
  [[ ! -L "$out/sandbox" ]] || die "$out/sandbox is a symlink; remove it"
  mkdir -p "$out/sandbox"
  need_image "$PROJECT_IMAGE"
  need_image "$GATE_IMAGE"
  # Model names go into opencode.json; brackets stay allowed for names such as deepseek-v4-pro[1m].
  local model_re='^[][A-Za-z0-9._:/-]+$'
  [[ "$MODEL" =~ $model_re && "$SMALL_MODEL" =~ $model_re ]] || die "model names may hold only letters, digits and ._:/-[]"
  local old_trap run_id
  old_trap="$(trap -p EXIT || true)"
  trap cleanup_runtime EXIT
  run_id="$(rand_hex 4)"
  proxy_token="$(gen_proxy_token)"
  gate="hutch-gate-${NAME}-${task}-$$-${run_id}"
  gate_up "$gate" "$dir/gate.conf.template" "$out/gate.log" "$task" "$proxy_token"
  url="http://${GATE_IP}:8080"
  if [[ -n "$CLAUDE_BASE" ]]; then probe="$url$CLAUDE_BASE/v1/messages"; else probe="$url$OPENCODE_BASE/chat/completions"; fi
  if [[ "$AGENT" == opencode ]]; then
    # Sessions live with the task, so a follow-up (hutch say) continues the same session.
    mkdir -p "$dir/oc-data"
    opencode_json "$url$OPENCODE_BASE" "$proxy_token" >"$dir/opencode.json"
    agent_args=(-v "$dir/oc-data:/home/hutch/.local/share/opencode"
      -v "$dir/opencode.json:/home/hutch/.config/opencode/opencode.json:ro"
      -v "${HUTCH_DIR}/rules/sandbox.md:/home/hutch/.config/opencode/AGENTS.md:ro"
      -e OPENCODE_API_KEY="$proxy_token")
  else
    mkdir -p "$dir/claude-data"
    agent_args=(-v "$dir/claude-data:/home/hutch/.claude" -v "${HUTCH_DIR}/rules/sandbox.md:/home/hutch/.claude/CLAUDE.md:ro"
      -e ANTHROPIC_AUTH_TOKEN="$proxy_token" -e ANTHROPIC_BASE_URL="$url$CLAUDE_BASE"
      -e ANTHROPIC_MODEL="$MODEL" -e ANTHROPIC_DEFAULT_OPUS_MODEL="$MODEL"
      -e ANTHROPIC_DEFAULT_SONNET_MODEL="$MODEL" -e ANTHROPIC_DEFAULT_HAIKU_MODEL="$SMALL_MODEL"
      -e CLAUDE_CODE_SUBAGENT_MODEL="$SMALL_MODEL" -e CLAUDE_CODE_EFFORT_LEVEL="${HUTCH_EFFORT:-max}"
      -e CLAUDE_CONFIG_DIR=/home/hutch/.claude)
    [[ -n "$COMPACT_WINDOW" ]] && agent_args+=(-e CLAUDE_CODE_AUTO_COMPACT_WINDOW="$COMPACT_WINDOW")
  fi
  extra=()
  [[ -f "$CONF/checklist.md" ]] && extra+=(-v "$CONF/checklist.md:/task/project-checklist.md:ro")
  [[ -f "$CONF/protected" ]] && extra+=(-v "$CONF/protected:/task/protected.txt:ro")
  [[ -f "$dir/opened" ]] && extra+=(-v "$dir/opened:/task/opened.txt:ro")
  [[ -s "$dir/context.md" ]] && extra+=(-v "$dir/context.md:/task/context.md:ro")
  overlay_up "${task}-$$-${run_id}"
  local -a cow_args=() run_cmd=("${SANDBOX_CMD[@]}")
  if [[ ${#OVERLAY_COW_PAIRS[@]} -gt 0 ]]; then
    cow_args=(-e "HUTCH_COW_MOUNTS=$(overlay_cow_env)")
    run_cmd=(bash -c "$(overlay_cow_script)" _ "${SANDBOX_CMD[@]}")
  fi
  local rc=0
  # shellcheck disable=SC2046 # limit_args prints whole docker flags
  docker run --rm ${SANDBOX_CONTAINER:+--name "$SANDBOX_CONTAINER"} "$@" \
    --network "$NET_INTERNAL" --cap-drop ALL --security-opt no-new-privileges \
    ${RUNTIME:+--runtime "$RUNTIME"} $(limit_args) --tmpfs /tmp:exec,size=4g \
    -v "$dir/repo:/work" -v "$dir/brief.md:/task/brief.md:ro" -v "$CONF/primer.md:/task/primer.md:ro" \
    -v "${HUTCH_DIR}/rules/checklist.md:/task/checklist.md:ro" -v "$out/sandbox:/out" \
    ${extra[@]+"${extra[@]}"} ${OVERLAY_DOCKER_ARGS[@]+"${OVERLAY_DOCKER_ARGS[@]}"} "${agent_args[@]}" \
    ${cow_args[@]+"${cow_args[@]}"} \
    -e HUTCH_PROXY_TOKEN="$proxy_token" -e HUTCH_PROBE_URL="$probe" -e HUTCH_GATE="$url" \
    "$PROJECT_IMAGE" "${run_cmd[@]}" || rc=$?
  cleanup_runtime
  trap - EXIT
  [[ -z "$old_trap" ]] || eval "$old_trap"
  return "$rc"
}

# offline runs a command in the project image with no network at all, under the same limits as the agent: the
# checks run the agent's code. Pass `--` between docker/image args and the container command when CoW overlays apply.
offline() {
  local -a pre_args=() cmd_args=() cow_args=()
  local seen_sep=0 arg ov_rc=0 old_trap="" has_ov_trap=0
  for arg in "$@"; do
    if [[ $seen_sep -eq 0 && "$arg" == "--" ]]; then seen_sep=1
    elif [[ $seen_sep -eq 0 ]]; then pre_args+=("$arg")
    else cmd_args+=("$arg"); fi
  done
  overlay_up "verify-$$-$(rand_hex 4)"
  if [[ ${#OVERLAY_VOLUMES[@]} -gt 0 || ${#OVERLAY_TMP_DIRS[@]} -gt 0 ]]; then
    old_trap="$(trap -p EXIT || true)"
    trap overlay_down EXIT
    has_ov_trap=1
  fi
  if [[ ${#OVERLAY_COW_PAIRS[@]} -gt 0 ]]; then
    cow_args=(-e "HUTCH_COW_MOUNTS=$(overlay_cow_env)")
  fi
  if [[ $seen_sep -eq 1 && ${#OVERLAY_COW_PAIRS[@]} -gt 0 ]]; then
    # shellcheck disable=SC2046
    docker run --rm --network none --cap-drop ALL --security-opt no-new-privileges --tmpfs /tmp:exec,size=4g \
      ${RUNTIME:+--runtime "$RUNTIME"} $(limit_args) ${OVERLAY_DOCKER_ARGS[@]+"${OVERLAY_DOCKER_ARGS[@]}"} \
      "${cow_args[@]}" "${pre_args[@]}" bash -c "$(overlay_cow_script)" _ "${cmd_args[@]}" || ov_rc=$?
  elif [[ $seen_sep -eq 1 ]]; then
    # shellcheck disable=SC2046
    docker run --rm --network none --cap-drop ALL --security-opt no-new-privileges --tmpfs /tmp:exec,size=4g \
      ${RUNTIME:+--runtime "$RUNTIME"} $(limit_args) ${OVERLAY_DOCKER_ARGS[@]+"${OVERLAY_DOCKER_ARGS[@]}"} \
      "${pre_args[@]}" "${cmd_args[@]}" || ov_rc=$?
  else
    # shellcheck disable=SC2046
    docker run --rm --network none --cap-drop ALL --security-opt no-new-privileges --tmpfs /tmp:exec,size=4g \
      ${RUNTIME:+--runtime "$RUNTIME"} $(limit_args) ${OVERLAY_DOCKER_ARGS[@]+"${OVERLAY_DOCKER_ARGS[@]}"} \
      ${cow_args[@]+"${cow_args[@]}"} "$@" || ov_rc=$?
  fi
  overlay_down
  if [[ $has_ov_trap -eq 1 ]]; then
    trap - EXIT
    [[ -z "$old_trap" ]] || eval "$old_trap"
  fi
  return "$ov_rc"
}

# ---- commands --------------------------------------------------------------------------------------------------

line() { printf '  %-22s %s\n' "$1" "$2"; }

cmd_status() {
  local rc=0 ok
  echo "hutch ${HUTCH_DIR} ($(git -C "$HUTCH_DIR" rev-parse --short HEAD 2>/dev/null || echo 'not a git checkout'))"
  echo "provider: $PROVIDER ($UPSTREAM), agent: $AGENT"
  echo "machine:"
  if docker info >/dev/null 2>&1; then line docker ok; else line docker "MISSING (start Docker)"; rc=4; fi
  if have_key; then line "key $KEY_ITEM" ok; else line "key $KEY_ITEM" "MISSING (AGENTS.md, Machine setup)"; rc=4; fi
  for ok in "$BASE_IMAGE" "$GATE_IMAGE"; do
    if docker image inspect "$ok" >/dev/null 2>&1; then line "$ok" ok; else line "$ok" "MISSING (hutch build)"; rc=4; fi
  done
  command -v hutch >/dev/null || echo "  hutch is not on PATH (optional: ln -s ${HUTCH_DIR}/hutch ~/.local/bin/hutch)"
  echo "project:"
  if ! try_resolve; then echo "  not inside a git repository (or HUTCH_PROJECT has no config)"; return "$rc"; fi
  line name "$NAME"
  line repo "$REPO"
  if [[ -z "$CONF" ]]; then
    line config "NOT SET UP (follow \"Project setup\" in ${HUTCH_DIR}/AGENTS.md)"
    [[ $rc -eq 0 ]] && rc=3
    return "$rc"
  fi
  line config "$CONF"
  if docker image inspect "$PROJECT_IMAGE" >/dev/null 2>&1; then line image "$PROJECT_IMAGE ok"
  else line image "$PROJECT_IMAGE MISSING (hutch build)"; [[ $rc -eq 0 ]] && rc=4; fi
  setup_runtime
  if [[ -n "$RUNTIME" ]]; then
    if docker_runtimes | grep -qx -- "$RUNTIME"; then line runtime "$RUNTIME ok"
    else line runtime "$RUNTIME MISSING (not in docker info; AGENTS.md, gVisor)"; [[ $rc -eq 0 ]] && rc=4; fi
  fi
  local ov_spec ov_entry ov_host ov_ctr cm
  ov_spec="$(cache_overlays_spec)"
  if [[ -n "$ov_spec" ]]; then
    local ov_mode; ov_mode="$(resolve_overlay_mode)"
    for ov_entry in $ov_spec; do
      validate_overlay_entry "$ov_entry"
      ov_host="$(resolve_overlay_host "${ov_entry%%:*}")"
      ov_ctr="${ov_entry#*:}"
      if [[ -d "$ov_host" ]]; then line "cache $ov_ctr" "ok (ro overlay from $ov_host, mode=$ov_mode)"
      else line "cache $ov_ctr" "MISSING ($ov_host not found)"; [[ $rc -eq 0 ]] && rc=4; fi
    done
  fi
  cm="$(conf_get cache_mount)"
  if [[ -n "$cm" ]]; then
    if docker volume inspect "$CACHE_VOLUME" >/dev/null 2>&1; then line "cache $cm" "ok (ro overlay from volume $CACHE_VOLUME)"
    else line "cache $cm" "ready (empty volume $CACHE_VOLUME; created on first use)"; fi
  fi
  [[ -n "$ov_spec" || -n "$cm" ]] || line cache "none (image-baked)"
  line tasks "$(ls "${STATE}/work" 2>/dev/null | tr '\n' ' ')"
  return "$rc"
}

cmd_init() {
  local dest
  resolve_project
  [[ -z "$CONF" ]] || die "already set up: $CONF"
  if [[ "${1:-}" == --in-repo ]]; then dest="$REPO/.hutch"; else dest="${HUTCH_HOME}/projects/${NAME}"; fi
  [[ ! -e "$dest" ]] || die "$dest exists"
  mkdir -p "$dest"
  /bin/cp -R "${HUTCH_DIR}/template/." "$dest/"
  { echo "name=$NAME"; [[ "$dest" == "$REPO/.hutch" ]] || echo "repo=$REPO"; } >>"$dest/config"
  echo "created $dest; fill in every file there (AGENTS.md, Project setup), then run hutch build"
}

cmd_build() {
  need_docker
  docker build -t "$BASE_IMAGE" --build-arg HUTCH_UID="$(id -u)" --build-arg HUTCH_GID="$(id -g)" "${HUTCH_DIR}/image"
  docker pull -q "$GATE_IMAGE" >/dev/null
  docker network inspect "$NET_INTERNAL" >/dev/null 2>&1 || docker network create --internal "$NET_INTERNAL" >/dev/null
  docker network inspect "$NET_EGRESS" >/dev/null 2>&1 || docker network create "$NET_EGRESS" >/dev/null
  # The allowlist proxy of earlier versions held no key but is no longer used: the gate replaced it.
  docker rm -f hutch-proxy >/dev/null 2>&1 || true
  CONF=""
  try_resolve || true
  if [[ -z "$CONF" ]]; then echo "base image and gate ready; no project here is set up, so no project image"; return; fi
  local re files branch
  BUILD_CTX="$(mktemp -d)"
  trap 'rm -rf "$BUILD_CTX"' EXIT
  mkdir "$BUILD_CTX/src"
  re="$(conf_get manifests)"
  branch="${HUTCH_BRANCH:-$(base_branch)}"
  # Dependency manifests only, from the committed base branch or $HUTCH_BRANCH, the branch tasks will clone: the
  # image changes when dependencies do, and a task on a branch that adds one still builds offline.
  if [[ -n "$re" ]]; then
    files="$(git -C "$REPO" ls-tree -r --name-only "$branch" | grep -E -- "$re" || true)"
    [[ -n "$files" ]] || die "manifests=$re matches no file on $branch"
    # shellcheck disable=SC2086 # one path per line, no spaces in manifest paths
    git -C "$REPO" archive "$branch" -- $files | tar -x -C "$BUILD_CTX/src"
  fi
  /bin/cp -f "$CONF/Dockerfile" "$BUILD_CTX/Dockerfile"
  docker build -t "$PROJECT_IMAGE" --build-arg HUTCH_BASE="$BASE_IMAGE" "$BUILD_CTX"
}

# pack_context writes numbered fenced markdown snippets from repo $1 to file $2 for each path[:start[-end]] spec.
pack_context() {
  local repo_dir="$1" out_file="$2"; shift 2
  [[ $# -gt 0 ]] || { : >"$out_file"; return 0; }
  python3 -I - "$repo_dir" "$out_file" "$@" <<'EOF'
import os, re, sys
from pathlib import Path

repo_real = os.path.realpath(sys.argv[1])
out_file = sys.argv[2]
specs = sys.argv[3:]

EXT_LANG = {
    ".ts": "ts", ".tsx": "tsx", ".js": "js", ".mjs": "js", ".cjs": "js", ".jsx": "jsx",
    ".py": "python", ".go": "go", ".rs": "rust", ".sh": "bash", ".bash": "bash",
    ".json": "json", ".yml": "yaml", ".yaml": "yaml", ".md": "markdown",
    ".sql": "sql", ".toml": "toml", ".css": "css", ".html": "html",
}

range_re = re.compile(r"^(.*):([0-9]+)(?:-([0-9]*))?$")
blocks = []

for raw_spec in specs:
    spec = raw_spec.strip()
    if not spec:
        continue
    m = range_re.match(spec)
    if m:
        rel, s_str, e_str = m.group(1), m.group(2), m.group(3)
        start = int(s_str)
        if e_str is None:
            end = start
        elif e_str == "":
            end = None
        else:
            end = int(e_str)
    else:
        rel, start, end = spec, 1, None

    if not rel or rel.startswith("/"):
        sys.stderr.write(f"hutch: --context path must be repo-relative: {raw_spec}\n")
        sys.exit(1)
    parts = Path(rel).parts
    if ".." in parts:
        sys.stderr.write(f"hutch: --context path cannot traverse '..': {raw_spec}\n")
        sys.exit(1)
    base = os.path.basename(rel)
    if base == ".env" or base.startswith(".env."):
        sys.stderr.write(f"hutch: --context cannot include secret env files: {raw_spec}\n")
        sys.exit(1)
    target = os.path.realpath(os.path.join(repo_real, rel))
    if not (target.startswith(repo_real + os.sep)):
        sys.stderr.write(f"hutch: --context path escapes repository: {raw_spec}\n")
        sys.exit(1)
    if not os.path.isfile(target):
        sys.stderr.write(f"hutch: --context file not found: {rel}\n")
        sys.exit(1)
    if start < 1 or (end is not None and end < start):
        sys.stderr.write(f"hutch: invalid --context line range: {raw_spec}\n")
        sys.exit(1)

    with open(target, errors="replace") as fh:
        lines = fh.read().splitlines()
    total = len(lines)
    if total == 0:
        if start > 1:
            sys.stderr.write(f"hutch: --context start line {start} exceeds empty file {rel}\n")
            sys.exit(1)
        header = f"### `{rel}` (empty file)"
        body = "(empty file)"
    else:
        if start > total:
            sys.stderr.write(f"hutch: --context start line {start} exceeds {rel} length ({total})\n")
            sys.exit(1)
        actual_end = min(end, total) if end is not None else total
        width = max(4, len(str(actual_end)))
        header = f"### `{rel}` (lines {start}-{actual_end} of {total})"
        body = "\n".join(f"{idx:>{width}} | {lines[idx - 1]}" for idx in range(start, actual_end + 1))

    lang = EXT_LANG.get(os.path.splitext(rel)[1].lower(), "")
    blocks.append(f"{header}\n```{lang}\n{body}\n```")

with open(out_file, "w") as out_fh:
    if blocks:
        out_fh.write("\n\n".join(blocks) + "\n")
EOF
}

cmd_new() {
  local task="" allow_file="" brief="" opened_opt="" dir
  local -a pos=() allow_globs=() context_specs=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --allow) [[ $# -ge 2 ]] || die "--allow requires a pattern"; allow_globs+=("$2"); shift 2 ;;
      --allow-file) [[ $# -ge 2 ]] || die "--allow-file requires a path"; allow_file="$2"; shift 2 ;;
      --brief) [[ $# -ge 2 ]] || die "--brief requires a path"; brief="$2"; shift 2 ;;
      --opened) [[ $# -ge 2 ]] || die "--opened requires a path"; opened_opt="$2"; shift 2 ;;
      --context) [[ $# -ge 2 ]] || die "--context requires a spec"; context_specs+=("$2"); shift 2 ;;
      --) shift; while [[ $# -gt 0 ]]; do pos+=("$1"); shift; done ;;
      -*) die "unknown option for new: $1" ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  [[ ${#pos[@]} -ge 1 && ${#pos[@]} -le 3 ]] ||
    die "usage: hutch new <task> [<allow-file> <brief-file>] [--allow <glob>...] [--allow-file <file>] [--brief <file>] [--opened <file>] [--context <spec>...]"
  task="${pos[0]}"
  if [[ ${#pos[@]} -ge 2 ]]; then
    [[ -z "$allow_file" ]] || die "cannot pass both positional allow-file and --allow-file"
    allow_file="${pos[1]}"
  fi
  if [[ ${#pos[@]} -ge 3 ]]; then
    [[ -z "$brief" ]] || die "cannot pass both positional brief-file and --brief"
    brief="${pos[2]}"
  fi
  [[ "$task" =~ ^[a-z0-9-]+$ ]] || die "task name must match [a-z0-9-]+"
  [[ -n "$brief" && -f "$brief" ]] || die "brief file must exist"
  if [[ -n "$allow_file" ]]; then
    [[ -f "$allow_file" ]] || die "allow file must exist: $allow_file"
  elif [[ ${#allow_globs[@]} -eq 0 ]]; then
    die "allow file or --allow pattern required"
  fi
  [[ -z "$opened_opt" || -f "$opened_opt" ]] || die "opened file must exist: $opened_opt"
  if [[ -n "${HUTCH_CONTEXT:-}" ]]; then
    local c
    for c in $HUTCH_CONTEXT; do context_specs+=("$c"); done
  fi
  dir="$(task_dir "$task")"
  [[ ! -e "$dir" ]] || die "$dir exists"
  mkdir -p "$dir" "$(out_dir "$task")"
  git clone --quiet --no-local --single-branch --branch "${HUTCH_BRANCH:-$(base_branch)}" "$REPO" "$dir/repo"
  git -C "$dir/repo" remote remove origin
  git -C "$dir/repo" switch --quiet -c "hutch/$task"
  git -C "$dir/repo" config user.name "hutch agent"
  git -C "$dir/repo" config user.email "hutch@localhost"
  git -C "$dir/repo" rev-parse HEAD >"$dir/base"
  mkdir -p "$dir/repo/.git/info"
  grep -qxF '.hutch-needs-scope' "$dir/repo/.git/info/exclude" 2>/dev/null ||
    echo '.hutch-needs-scope' >>"$dir/repo/.git/info/exclude"
  if [[ -n "$allow_file" ]]; then /bin/cp -f "$allow_file" "$dir/allow"; else : >"$dir/allow"; fi
  if [[ ${#allow_globs[@]} -gt 0 ]]; then
    local g
    for g in "${allow_globs[@]}"; do printf '%s\n' "$g" >>"$dir/allow"; done
  fi
  /bin/cp -f "$brief" "$dir/brief.md"
  local opened_src="${opened_opt:-${HUTCH_OPENED:-}}"
  if [[ -n "$opened_src" ]]; then /bin/cp -f "$opened_src" "$dir/opened"; echo "opened: $(tr '\n' ' ' <"$dir/opened")"; fi
  if [[ ${#context_specs[@]} -gt 0 ]]; then
    printf '%s\n' "${context_specs[@]}" >"$dir/context.specs"
    pack_context "$dir/repo" "$dir/context.md" "${context_specs[@]}"
  fi
  echo "workspace $dir at $(cat "$dir/base")"
}

# user_line prints one stream-json user message (Claude Code agent).
user_line() {
  python3 -I -c 'import json, sys; print(json.dumps({"type": "user", "message": {"role": "user", "content": [{"type": "text", "text": sys.argv[1]}]}}))' "$1"
}

# run_idle is true when the log's last event is a result, the log has not changed for HUTCH_IDLE_S seconds (default
# 120) and no message was sent after it. A background task's notification also ends in a result, so counting results
# per message does not work.
run_idle() {
  python3 -I - "$1" "$2" "${HUTCH_IDLE_S:-120}" <<'EOF'
import json, os, sys, time
log, steer, idle = sys.argv[1], sys.argv[2], int(sys.argv[3])
last = None
for line in open(log):
    try:
        last = json.loads(line).get("type")
    except (ValueError, AttributeError):
        last = None
quiet = time.time() - os.path.getmtime(log) >= idle
sys.exit(0 if last == "result" and quiet and os.path.getmtime(steer) <= os.path.getmtime(log) else 1)
EOF
}

kickoff() {
  local task="${1:-}" base ctx_file
  case "${HUTCH_PHASE:-}" in
    design) base="PHASE 1 (design only). Read /task/primer.md, /task/brief.md, /task/checklist.md and /task/project-checklist.md if it exists, then the sources the brief names. Write /out/design-notes.md exactly as the checklist's 'Design notes' section says. Do not change any file under /work, run no generator and commit nothing. Then stop with a two-line report." ;;
    build) base="PHASE 2 (build). Read /task/primer.md, /task/brief.md, /task/checklist.md, /task/project-checklist.md if it exists, and /out/design-notes.md; its 'Reviewer notes' section, if present, overrides the notes. Complete the task under your sandbox rules, following the design notes." ;;
    "") base="Read /task/primer.md, then /task/brief.md, /task/checklist.md and /task/project-checklist.md if it exists, and complete the task under your sandbox rules." ;;
    *) die "HUTCH_PHASE must be design or build" ;;
  esac
  if [[ -n "$task" ]]; then
    ctx_file="$(task_dir "$task")/context.md"
    if [[ -s "$ctx_file" ]]; then
      python3 -I - "$base" "$ctx_file" <<'EOF'
import sys
base, path = sys.argv[1], sys.argv[2]
with open(path, errors="replace") as fh:
    data = fh.read()
limit = 98304
if len(data.encode("utf-8")) > limit:
    encoded = data.encode("utf-8")[:limit].decode("utf-8", errors="ignore")
    data = encoded + "\n... (truncated inline; full context in /task/context.md)\n"
sys.stdout.write(base + "\n\n## Pre-packed context (use these snippets directly; avoid redundant discovery)\n\n" + data)
EOF
      return
    fi
  fi
  echo "$base"
}

# watchdog_inspect inspects run.jsonl, the .hutch-needs-scope files, the turn count and repeated failures.
# Outputs ACTION=... and REASON=... (plus writes payload to $out_dir/watchdog.detail) when an abort should fire.
watchdog_inspect() {
  python3 -I - "$1" "$2" "$3" "$4" "$5" <<'EOF'
import json, os, re, stat, sys

log_path, work_dir, out_dir = sys.argv[1], sys.argv[2], sys.argv[3]
max_turns, loop_threshold = int(sys.argv[4]), int(sys.argv[5])
detail_file = os.path.join(out_dir, "watchdog.detail")

# 1. Early scope escalation (.hutch-needs-scope or HUTCH_NEEDS_SCOPE: markers)
scope_paths = []
seen_paths = set()

def add_path(p):
    p = p.strip().strip("`'\",;")
    if p and p not in seen_paths:
        seen_paths.add(p)
        scope_paths.append(p)

def read_regular(path):
    # The sandbox writes these files: never follow a symlink, never block on a FIFO, read only a regular file.
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return ""
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return ""
        return os.read(fd, 65536).decode("utf-8", "replace")
    finally:
        os.close(fd)

for candidate in (os.path.join(work_dir, ".hutch-needs-scope"), os.path.join(out_dir, "sandbox", ".hutch-needs-scope")):
    for raw in read_regular(candidate).splitlines():
        line = raw.split("#", 1)[0].strip()
        if line:
            add_path(line)

def assistant_texts(e):
    # Only the agent's own words count as a scope request, never a tool's output that it quotes.
    etype = e.get("type")
    if etype == "text":
        part = e.get("part")
        if isinstance(part, dict) and isinstance(part.get("text"), str):
            yield part["text"]
    elif etype == "assistant":
        msg = e.get("message")
        content = msg.get("content") if isinstance(msg, dict) else None
        if isinstance(content, list):
            for blk in content:
                if isinstance(blk, dict) and blk.get("type") == "text" and isinstance(blk.get("text"), str):
                    yield blk["text"]
    elif etype == "result" and isinstance(e.get("result"), str):
        yield e["result"]

def flatten_text(obj):
    if obj is None:
        return ""
    if isinstance(obj, str):
        return obj
    if isinstance(obj, list):
        return "\n".join(flatten_text(x) for x in obj if x is not None)
    if isinstance(obj, dict):
        if "text" in obj and isinstance(obj["text"], str):
            return obj["text"]
        if "content" in obj:
            return flatten_text(obj["content"])
        return json.dumps(obj, sort_keys=True)
    return str(obj)

ansi_re = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
def norm_ws(s):
    return re.sub(r"\s+", " ", (s or "").strip())

def norm_err(s):
    s = ansi_re.sub("", s or "")
    return norm_ws(s)[:300]

# An error text that says no more than "error" or "exit code N" cannot tell two failures apart.
generic_re = re.compile(r"(?i)\b(?:error|exit(?:\s+code|\s+status)?)\b[:\s]*-?\d*")
def is_generic(s):
    return not re.sub(r"[\W_]+", "", generic_re.sub("", s or ""))

marker_re = re.compile(r"^\s*HUTCH_NEEDS_SCOPE:\s*(.+)$", re.MULTILINE)
exit_code_re = re.compile(r"(?:^|\n)Exit code\s+([1-9][0-9]*)\b")

started_turns = 0
finished_turns = 0
seen_assistant_ids = set()
pending_tools = {}

streak = 0
last_sig = None
last_detail = ""

def record_success():
    global streak, last_sig
    streak = 0
    last_sig = None

# A loop is the same command failing with the same error; a failure without a command or with a generic error
# breaks the streak instead of adding to it.
def record_failure(cmd_sig, err_sig, detail):
    global streak, last_sig, last_detail
    if not cmd_sig or is_generic(err_sig):
        record_success()
        return
    sig = (cmd_sig, err_sig)
    if sig == last_sig:
        streak += 1
    else:
        last_sig = sig
        streak = 1
    last_detail = detail.strip()

def inspect(e):
    global started_turns, finished_turns
    for txt in assistant_texts(e):
        for m in marker_re.finditer(txt):
            for tok in re.split(r"[,\s]+", m.group(1).strip()):
                if tok:
                    add_path(tok)

    etype = e.get("type")
    part = e.get("part") if isinstance(e.get("part"), dict) else {}
    ptype = part.get("type")

    if etype == "step_start" or ptype == "step-start" or etype in ("turn", "turn_start"):
        started_turns += 1
    elif etype == "step_finish" or ptype == "step-finish":
        finished_turns += 1
    elif etype == "assistant":
        msg = e.get("message") if isinstance(e.get("message"), dict) else {}
        mid = msg.get("id")
        if mid:
            if mid not in seen_assistant_ids:
                seen_assistant_ids.add(mid)
                started_turns += 1
        else:
            started_turns += 1
        content = msg.get("content")
        if isinstance(content, list):
            for blk in content:
                if isinstance(blk, dict) and blk.get("type") == "tool_use" and blk.get("id"):
                    pending_tools[blk["id"]] = (blk.get("name") or "", blk.get("input") or {})
    elif etype == "user":
        msg = e.get("message") if isinstance(e.get("message"), dict) else {}
        content = msg.get("content")
        if isinstance(content, list):
            for blk in content:
                if isinstance(blk, dict) and blk.get("type") == "tool_result":
                    tid = blk.get("tool_use_id")
                    tname, tinp = pending_tools.get(tid, ("", {}))
                    if not isinstance(tinp, dict):
                        tinp = {}
                    cmd = tinp.get("command") or tinp.get("cmd") or ""
                    cstr = flatten_text(blk.get("content"))
                    is_err = bool(blk.get("is_error"))
                    if not is_err and exit_code_re.search(cstr):
                        is_err = True
                    if is_err:
                        csig = norm_ws(cmd) if cmd else (f"{tname}:{norm_ws(json.dumps(tinp, sort_keys=True))}" if tname else "")
                        detail = (f"command: {cmd}\n" if cmd else f"tool: {tname}\n") + cstr[:1500]
                        record_failure(csig, norm_err(cstr), detail)
                    else:
                        record_success()
    elif etype == "tool_use":
        state = part.get("state") if isinstance(part.get("state"), dict) else {}
        status = state.get("status")
        inp = state.get("input") if isinstance(state.get("input"), dict) else {}
        tool = part.get("tool") or ""
        cmd = inp.get("command") or inp.get("cmd") or ""
        meta = state.get("metadata") if isinstance(state.get("metadata"), dict) else {}
        exit_code = meta.get("exit")
        err_txt = flatten_text(state.get("error"))
        out_txt = flatten_text(state.get("output"))
        if status == "error" or (isinstance(exit_code, int) and exit_code != 0) or bool(err_txt):
            csig = norm_ws(cmd) if cmd else (f"{tool}:{norm_ws(json.dumps(inp, sort_keys=True))}" if tool else "")
            combined = err_txt or out_txt or f"exit {exit_code}"
            detail = (f"command: {cmd}\n" if cmd else f"tool: {tool}\n") + combined[:1500]
            record_failure(csig, norm_err(combined), detail)
        elif status == "completed":
            record_success()
    elif etype == "result":
        nt = e.get("num_turns")
        if isinstance(nt, int):
            finished_turns = max(finished_turns, nt)
    elif etype == "command_result":
        cmd = e.get("command") or ""
        ec = e.get("exit_code", 0)
        rtxt = flatten_text(e.get("error") or e.get("output") or "")
        if isinstance(ec, int) and ec != 0:
            record_failure(norm_ws(cmd), norm_err(rtxt or f"exit {ec}"), f"command: {cmd}\n{rtxt[:1500]}")
        else:
            record_success()

if os.path.isfile(log_path):
    with open(log_path, errors="replace") as fh:
        for raw in fh:
            # The agent writes this log: a line that is not JSON, or holds unexpected types, is skipped.
            try:
                e = json.loads(raw)
                if isinstance(e, dict):
                    inspect(e)
            except Exception:
                continue

if scope_paths:
    with open(detail_file, "w") as dfh:
        dfh.write("\n".join(scope_paths) + "\n")
    print("ACTION=NEEDS_SCOPE")
    print("REASON=sandbox requested additional scope")
    sys.exit(0)

if loop_threshold > 0 and streak >= loop_threshold:
    with open(detail_file, "w") as dfh:
        dfh.write(last_detail + "\n" if last_detail else "")
    print("ACTION=LOOP_DETECTED")
    print(f"REASON=identical failing command and error repeated {streak} times")
    sys.exit(0)

if max_turns > 0 and max(started_turns, finished_turns) > max_turns:
    with open(detail_file, "w") as dfh:
        dfh.write(f"turns started={started_turns}, finished={finished_turns}, max_turns={max_turns}\n")
    print("ACTION=MAX_TURNS")
    print(f"REASON=exceeded max_turns={max_turns}")
    sys.exit(0)
EOF
}

stop_sandbox_run() {
  local ctr="$1" job_pid="$2" tail_pid="${3:-}"
  [[ -n "$tail_pid" ]] && kill "$tail_pid" 2>/dev/null || true
  if [[ -n "$ctr" ]] && command -v docker >/dev/null 2>&1; then
    docker rm -f "$ctr" >/dev/null 2>&1 || true
  fi
  if [[ -n "$job_pid" ]]; then
    command -v pkill >/dev/null 2>&1 && pkill -P "$job_pid" 2>/dev/null || true
    kill "$job_pid" 2>/dev/null || true
    wait "$job_pid" 2>/dev/null || true
  fi
  # A job killed while gate_up runs can miss its gate, which holds the key: remove this run's gates by name
  # (hutch-gate-<project>-<task>-<pid>-, as sandbox names them).
  if [[ -n "$ctr" ]] && command -v docker >/dev/null 2>&1; then
    local gate_prefix g
    gate_prefix="hutch-gate-${ctr#hutch-run-}"; gate_prefix="${gate_prefix%-*}-"
    for g in $(docker ps -aq --filter "name=$gate_prefix" 2>/dev/null); do docker rm -f "$g" >/dev/null 2>&1 || true; done
  fi
}

handle_watchdog_action() {
  local action="$1" reason="$2" out="$3"
  case "$action" in
    NEEDS_SCOPE)
      /bin/cp -f "$out/watchdog.detail" "$out/needs-scope.txt"
      echo "$EXIT_NEEDS_SCOPE" >"$out/exit.code"
      echo "EARLY_ABORT: NEEDS_SCOPE"
      cat "$out/needs-scope.txt"
      return "$EXIT_NEEDS_SCOPE" ;;
    LOOP_DETECTED)
      { echo "EARLY_ABORT: LOOP_DETECTED ($reason)"; [[ -s "$out/watchdog.detail" ]] && cat "$out/watchdog.detail"; } >"$out/abort.log"
      echo "$EXIT_LOOP_DETECTED" >"$out/exit.code"
      cat "$out/abort.log"
      return "$EXIT_LOOP_DETECTED" ;;
    MAX_TURNS)
      { echo "EARLY_ABORT: MAX_TURNS ($reason)"; [[ -s "$out/watchdog.detail" ]] && cat "$out/watchdog.detail"; } >"$out/abort.log"
      echo "$EXIT_MAX_TURNS" >"$out/exit.code"
      cat "$out/abort.log"
      return "$EXIT_MAX_TURNS" ;;
  esac
}

# The Claude Code session reads stream-json from steer.jsonl through tail, so hutch say reaches it mid-run. When the
# session is idle (run_idle) or the sandbox has exited, tail is stopped and stdin closes, which ends the session.
cmd_run() {
  local task="" max_turns_opt="" max_timeout_opt="" loop_opt=""
  local -a cli_ctx=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --context) [[ $# -ge 2 ]] || die "--context requires a spec"; cli_ctx+=("$2"); shift 2 ;;
      --max-turns) [[ $# -ge 2 ]] || die "--max-turns requires a number"; max_turns_opt="$2"; shift 2 ;;
      --max-timeout) [[ $# -ge 2 ]] || die "--max-timeout requires whole seconds"; max_timeout_opt="$2"; shift 2 ;;
      --loop-threshold) [[ $# -ge 2 ]] || die "--loop-threshold requires a number"; loop_opt="$2"; shift 2 ;;
      --) shift; [[ $# -gt 0 && -z "$task" ]] && { task="$1"; shift; }; break ;;
      -*) die "unknown option for run: $1" ;;
      *) [[ -z "$task" ]] || die "unexpected argument for run: $1"; task="$1"; shift ;;
    esac
  done
  need_task "$task"
  need_models
  need_pro_kind "$task"

  local dir out steer tailpid="" msg limit max_turns loop_threshold
  dir="$(task_dir "$task")"; out="$(out_dir "$task")"; steer="$out/steer.jsonl"

  if [[ -n "$max_timeout_opt" ]]; then
    [[ "$max_timeout_opt" =~ ^[0-9]+$ ]] || die "--max-timeout must be whole seconds, got '$max_timeout_opt'"
    limit="$max_timeout_opt"
  else
    limit="$(run_timeout)"
  fi
  max_turns="${max_turns_opt:-${HUTCH_MAX_TURNS:-$(conf_get max_turns)}}"
  max_turns="${max_turns:-0}"
  [[ "$max_turns" =~ ^[0-9]+$ ]] || die "max_turns must be a whole number, got '$max_turns'"
  loop_threshold="${loop_opt:-${HUTCH_LOOP_THRESHOLD:-$(conf_get loop_threshold)}}"
  loop_threshold="${loop_threshold:-3}"
  [[ "$loop_threshold" =~ ^[0-9]+$ ]] || die "loop_threshold must be a whole number, got '$loop_threshold'"

  local -a merged_ctx=() dedup_ctx=()
  if [[ -f "$dir/context.specs" ]]; then
    local line
    while IFS= read -r line; do [[ -n "$line" ]] && merged_ctx+=("$line"); done <"$dir/context.specs"
  fi
  if [[ ${#cli_ctx[@]} -gt 0 ]]; then
    local c; for c in "${cli_ctx[@]}"; do merged_ctx+=("$c"); done
  fi
  if [[ -n "${HUTCH_CONTEXT:-}" ]]; then
    local c; for c in $HUTCH_CONTEXT; do merged_ctx+=("$c"); done
  fi
  if [[ ${#merged_ctx[@]} -gt 0 ]]; then
    local c seen
    for c in "${merged_ctx[@]}"; do
      seen=0
      if [[ ${#dedup_ctx[@]} -gt 0 ]]; then
        local d; for d in "${dedup_ctx[@]}"; do [[ "$d" == "$c" ]] && { seen=1; break; }; done
      fi
      [[ $seen -eq 0 ]] && dedup_ctx+=("$c")
    done
    printf '%s\n' "${dedup_ctx[@]}" >"$dir/context.specs"
    pack_context "$dir/repo" "$dir/context.md" "${dedup_ctx[@]}"
  fi

  msg="$(kickoff "$task")"
  /bin/rm -f "$out/tail.pid" "$out/exit.code" "$out/needs-scope.txt" "$out/abort.log" "$out/watchdog.detail"
  # A scope request belongs to the run that wrote it; a leftover one would stop every later run at once.
  /bin/rm -rf "$dir/repo/.hutch-needs-scope"
  [[ -L "$out/sandbox" ]] || /bin/rm -rf "$out/sandbox/.hutch-needs-scope"
  # A later phase keeps the earlier phase's log.
  [[ -s "$out/run.jsonl" ]] && /bin/mv -f "$out/run.jsonl" "$out/run.$(date +%Y%m%d%H%M%S).jsonl"
  : >"$out/run.jsonl"
  echo "$(date -u +%FT%TZ) agent=$AGENT provider=$PROVIDER kind=$KIND model=$MODEL small=$SMALL_MODEL phase=${HUTCH_PHASE:-}" >>"$out/models.log"

  RUN_ID="$(rand_hex 4)"
  SANDBOX_CONTAINER="hutch-run-${NAME}-${task}-$$-${RUN_ID}"
  local job
  if [[ "$AGENT" == opencode ]]; then
    # opencode run takes one message and exits when the agent stops; hutch say continues the session afterwards.
    : >"$steer"
    SANDBOX_CMD=(timeout -k 30 "$limit" opencode run --standalone --auto --format json --title "$task" "$msg")
    (
      rc=0
      sandbox "$task" >"$out/run.jsonl" 2>"$out/run.err" || rc=$?
      echo "$rc" >"$out/exit.code"
    ) </dev/null >/dev/null 2>&1 &
    job=$!
  else
    user_line "$msg" >"$steer"
    SANDBOX_CMD=(timeout -k 30 "$limit" claude -p --input-format stream-json --output-format stream-json --verbose
      --dangerously-skip-permissions)
    (
      set +o pipefail
      sh -c 'echo $$ >"$1"; exec tail -n +1 -f "$2"' _ "$out/tail.pid" "$steer" |
        { rc=0; sandbox "$task" -i >"$out/run.jsonl" 2>"$out/run.err" || rc=$?; echo "$rc" >"$out/exit.code"; }
    ) >/dev/null 2>&1 &
    job=$!
    until [[ -s "$out/tail.pid" || -f "$out/exit.code" ]] || ! kill -0 "$job" 2>/dev/null; do sleep 0.1; done
    [[ -s "$out/tail.pid" ]] && tailpid="$(cat "$out/tail.pid")"
  fi

  local start_ts ticks=0 poll_s inspect_out action reason abort_rc=0
  start_ts="$(date +%s)"
  while :; do
    inspect_out="$(watchdog_inspect "$out/run.jsonl" "$dir/repo" "$out" "$max_turns" "$loop_threshold")" || {
      stop_sandbox_run "$SANDBOX_CONTAINER" "$job" "$tailpid"
      die "the watchdog failed, so the run was stopped"
    }
    if [[ -n "$inspect_out" ]]; then
      action="$(printf '%s\n' "$inspect_out" | awk -F= '$1 == "ACTION" { print $2; exit }')"
      reason="$(printf '%s\n' "$inspect_out" | awk -F= '$1 == "REASON" { print substr($0, 8); exit }')"
      stop_sandbox_run "$SANDBOX_CONTAINER" "$job" "$tailpid"
      SANDBOX_CONTAINER=""
      /bin/rm -f "$out/tail.pid"
      handle_watchdog_action "$action" "$reason" "$out" || abort_rc=$?
      return "$abort_rc"
    fi
    # The run ends when the sandbox command has finished or its job is gone (exit.code is in a directory only hutch
    # writes).
    if [[ -f "$out/exit.code" ]] || ! kill -0 "$job" 2>/dev/null; then break; fi
    # A limit of 0 means no limit, as with timeout.
    if (( limit > 0 && $(date +%s) - start_ts >= limit )); then
      stop_sandbox_run "$SANDBOX_CONTAINER" "$job" "$tailpid"
      SANDBOX_CONTAINER=""
      /bin/rm -f "$out/tail.pid"
      echo "$TIMED_OUT" >"$out/exit.code"
      echo "log: $out/run.jsonl (sandbox exit $TIMED_OUT)"
      echo "hutch: the run hit its ${limit}s limit (HUTCH_RUN_TIMEOUT / run_timeout)" >&2
      return "$TIMED_OUT"
    fi
    if [[ "$AGENT" != opencode ]] && run_idle "$out/run.jsonl" "$steer"; then break; fi
    if [[ -n "${HUTCH_WATCHDOG_POLL:-}" ]]; then poll_s="$HUTCH_WATCHDOG_POLL"
    elif [[ $ticks -lt 5 ]]; then poll_s=0.2
    else poll_s=1; fi
    ticks=$((ticks + 1))
    sleep "$poll_s"
  done

  [[ -n "$tailpid" ]] && kill "$tailpid" 2>/dev/null || true
  local rc=0
  wait "$job" || rc=$?
  # The job writes the sandbox's exit code; a job that died before writing it leaves its own status.
  if [[ -f "$out/exit.code" ]]; then rc="$(cat "$out/exit.code")"; else echo "$rc" >"$out/exit.code"; fi
  SANDBOX_CONTAINER=""
  /bin/rm -f "$out/tail.pid"
  inspect_out="$(watchdog_inspect "$out/run.jsonl" "$dir/repo" "$out" "$max_turns" "$loop_threshold")"
  if [[ -n "$inspect_out" ]]; then
    action="$(printf '%s\n' "$inspect_out" | awk -F= '$1 == "ACTION" { print $2; exit }')"
    reason="$(printf '%s\n' "$inspect_out" | awk -F= '$1 == "REASON" { print substr($0, 8); exit }')"
    handle_watchdog_action "$action" "$reason" "$out" || abort_rc=$?
    return "$abort_rc"
  fi
  echo "log: $out/run.jsonl (sandbox exit $rc)"
  [[ "$rc" == "$TIMED_OUT" ]] &&
    echo "hutch: the run hit its ${limit}s limit (HUTCH_RUN_TIMEOUT / run_timeout)" >&2
  return "$rc"
}

batch_outcome_label() {
  case "$1" in
    0) echo "ok" ;;
    "$EXIT_NEEDS_SCOPE") echo "NEEDS_SCOPE" ;;
    "$EXIT_LOOP_DETECTED") echo "LOOP_DETECTED" ;;
    "$EXIT_MAX_TURNS") echo "MAX_TURNS" ;;
    "$TIMED_OUT") echo "TIMEOUT" ;;
    *) echo "failed" ;;
  esac
}

# cmd_batch runs multiple existing tasks concurrently (bounded by --max-parallel if given) with isolated
# per-run gates, overlays, agent state, and logs, then prints a summary table and exits non-zero if any failed.
cmd_batch() {
  local max_parallel=0
  local -a run_flags=() batch_tasks=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --max-parallel)
        [[ $# -ge 2 && "$2" =~ ^[1-9][0-9]*$ ]] || die "--max-parallel requires a positive integer"
        max_parallel="$2"; shift 2 ;;
      --max-turns|--max-timeout|--loop-threshold)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        run_flags+=("$1" "$2"); shift 2 ;;
      --) shift; while [[ $# -gt 0 ]]; do batch_tasks+=("$1"); shift; done ;;
      -*) die "unknown option for batch: $1" ;;
      *) batch_tasks+=("$1"); shift ;;
    esac
  done
  [[ ${#batch_tasks[@]} -gt 0 ]] ||
    die "usage: hutch batch [--max-parallel <N>] [--max-turns <N>] [--max-timeout <S>] [--loop-threshold <N>] <task1> <task2>..."
  need_models
  local t
  for t in "${batch_tasks[@]}"; do
    need_task "$t"
    need_pro_kind "$t"
  done

  local -a pids=() active_idx=() rcs=()
  local i n="${#batch_tasks[@]}" k rc next_pids=() next_idx=()
  for (( i = 0; i < n; i++ )); do rcs+=(-1); done

  for (( i = 0; i < n; i++ )); do
    if [[ $max_parallel -gt 0 ]]; then
      while [[ ${#pids[@]} -ge $max_parallel ]]; do
        sleep 0.1
        next_pids=(); next_idx=()
        for (( k = 0; k < ${#pids[@]}; k++ )); do
          if kill -0 "${pids[$k]}" 2>/dev/null; then
            next_pids+=("${pids[$k]}")
            next_idx+=("${active_idx[$k]}")
          else
            rc=0
            wait "${pids[$k]}" || rc=$?
            rcs[${active_idx[$k]}]="$rc"
          fi
        done
        pids=(${next_pids[@]+"${next_pids[@]}"})
        active_idx=(${next_idx[@]+"${next_idx[@]}"})
      done
    fi
    t="${batch_tasks[$i]}"
    echo "batch: starting $t"
    (
      cmd_run ${run_flags[@]+"${run_flags[@]}"} "$t" >"$(out_dir "$t")/batch.log" 2>&1
    ) </dev/null >/dev/null 2>&1 &
    pids+=($!)
    active_idx+=("$i")
  done

  if [[ ${#pids[@]} -gt 0 ]]; then
    for (( k = 0; k < ${#pids[@]}; k++ )); do
      rc=0
      wait "${pids[$k]}" || rc=$?
      rcs[${active_idx[$k]}]="$rc"
    done
  fi

  local any_fail=0 label
  echo "== batch summary"
  printf '%-24s %-6s %s\n' TASK EXIT OUTCOME
  for (( i = 0; i < n; i++ )); do
    t="${batch_tasks[$i]}"
    rc="${rcs[$i]}"
    label="$(batch_outcome_label "$rc")"
    printf '%-24s %-6s %s\n' "$t" "$rc" "$label"
    [[ "$rc" -eq 0 ]] || any_fail=1
  done
  return "$any_fail"
}

cmd_say() {
  need_task "$1"
  need_models
  need_pro_kind "$1"
  local out; out="$(out_dir "$1")"
  if [[ "$AGENT" == opencode ]]; then
    [[ -f "$out/exit.code" ]] || die "$1 has no finished run; opencode takes a follow-up only after the run stops"
    /bin/rm -f "$out/exit.code"
    SANDBOX_CMD=(timeout -k 30 "$(run_timeout)" opencode run --standalone --auto --format json --continue "$2")
    local rc=0
    sandbox "$1" >>"$out/run.jsonl" 2>>"$out/run.err" || rc=$?
    echo "$rc" >"$out/exit.code"
    echo "follow-up done: $out/run.jsonl (sandbox exit $rc)"
    return "$rc"
  fi
  if ! { [[ -s "$out/tail.pid" ]] && kill -0 "$(cat "$out/tail.pid")" 2>/dev/null; }; then die "no run of $1 is reading messages"; fi
  user_line "$2" >>"$out/steer.jsonl"
  echo "sent to $1"
}

cmd_shell() {
  need_task "$1"
  need_models
  if [[ "$AGENT" == opencode ]]; then SANDBOX_CMD=(opencode --standalone --auto "${@:2}")
  else SANDBOX_CMD=(claude --dangerously-skip-permissions "${@:2}"); fi
  sandbox "$1" -it
}

cmd_export() {
  need_task "$1"
  local dir; dir="$(task_dir "$1")"
  need_image "$PROJECT_IMAGE"
  # git runs in a network-less container, so hooks or config the agent wrote never run on the host. It writes to an
  # empty directory, not to the output directory, so it cannot leave symlinks among the files hutch writes.
  /bin/rm -rf "$dir/export"; mkdir "$dir/export"
  docker run --rm --network none --cap-drop ALL ${RUNTIME:+--runtime "$RUNTIME"} -v "$dir/repo:/work:ro" -v "$dir/export:/out" \
    -e GIT_CONFIG_NOSYSTEM=1 "$PROJECT_IMAGE" \
    git -c core.hooksPath=/dev/null -c safe.directory=/work bundle create "/out/$1.bundle" "$(cat "$dir/base")..hutch/$1"
  [[ -f "$dir/export/$1.bundle" && ! -L "$dir/export/$1.bundle" ]] || die "export wrote no bundle"
  /bin/mv -f "$dir/export/$1.bundle" "$(out_dir "$1")/$1.bundle"
  /bin/rm -rf "$dir/export"
}

cmd_verify() {
  local task="" mode_arg="" allow_tests=0 allow_override=""
  local -a extra_globs=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --soft-scope) mode_arg=soft; shift ;;
      --strict-scope) mode_arg=strict; shift ;;
      --allow-tests) allow_tests=1; shift ;;
      --allow) [[ $# -ge 2 ]] || die "--allow requires a pattern"; extra_globs+=("$2"); shift 2 ;;
      --allow-file) [[ $# -ge 2 ]] || die "--allow-file requires a path"; allow_override="$2"; shift 2 ;;
      --) shift; [[ $# -gt 0 && -z "$task" ]] && { task="$1"; shift; }; break ;;
      -*) die "unknown option for verify: $1" ;;
      *) [[ -z "$task" ]] || die "unexpected argument for verify: $1"; task="$1"; shift ;;
    esac
  done
  need_task "$task"
  local dir out base ref bundle heads files f bad=0 tree mode
  local -a unscoped=()
  dir="$(task_dir "$task")"; out="$(out_dir "$task")"; base="$(cat "$dir/base")"; ref="refs/hutch/$task"
  bundle="$out/$task.bundle"
  mode="$(scope_mode "$mode_arg")"
  [[ "${HUTCH_ALLOW_TESTS:-}" == 1 ]] && allow_tests=1
  ALLOW_FILE="${allow_override:-$dir/allow}"; OPENED_FILE="$dir/opened"
  EXTRA_ALLOW=""
  if [[ ${#extra_globs[@]} -gt 0 ]]; then
    local g
    for g in "${extra_globs[@]}"; do EXTRA_ALLOW+="${g}"$'\n'; done
  fi
  [[ -f "$ALLOW_FILE" ]] || die "allow file not found: $ALLOW_FILE"
  [[ -f "$bundle" ]] || die "no bundle; run hutch export $task"
  # The outcome is kept for hutch report; every failure below goes through vfail.
  vfail() { echo "failed: $*" >"$out/verify.status"; die "$*"; }
  echo "running" >"$out/verify.status"
  git -C "$REPO" bundle verify --quiet "$bundle"
  heads="$(git -C "$REPO" bundle list-heads "$bundle" | awk '$2 ~ /^refs\/heads\// { print $2 }')"
  [[ -n "$heads" && "$(wc -l <<<"$heads")" -eq 1 ]] || vfail "the bundle must hold exactly one branch, has: ${heads:-none}"
  git -C "$REPO" fetch --quiet --no-tags "$bundle" "+$heads:$ref"
  git -C "$REPO" merge-base --is-ancestor "$base" "$ref" || vfail "$ref does not build on $base"
  echo "== commits"; git -C "$REPO" log --oneline "$base..$ref"
  echo "== files (scope=$mode)"
  files="$(git -C "$REPO" diff --name-only "$base" "$ref")"
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    if protected "$f"; then echo "PROTECTED $f"; bad=1
    elif [[ $allow_tests -ne 1 ]] && is_preexisting_test "$base" "$f"; then
      echo "PROTECTED-TEST $f (pre-existing test; pass --allow-tests to permit)"; bad=1
    elif allowed "$f"; then echo "ok $f"
    elif [[ "$mode" == soft ]]; then echo "UNSCOPED $f"; unscoped+=("$f")
    else echo "NOT-ALLOWED $f"; bad=1; fi
  done <<<"$files"
  if [[ ${#unscoped[@]} -gt 0 ]]; then
    echo "== WARN: UNSCOPED_PATHS"
    for f in "${unscoped[@]}"; do echo "UNSCOPED $f"; done
    echo "--- unscoped diff stat ---"
    git -C "$REPO" diff --stat "$base" "$ref" -- "${unscoped[@]}"
    printf '%s\n' "${unscoped[@]}" >"$out/unscoped.txt"
  else
    /bin/rm -f "$out/unscoped.txt"
  fi
  echo "== added comment lines"
  git -C "$REPO" diff -U0 "$base" "$ref" -- . ':(exclude)*.md' |
    grep -E '^\+[[:space:]]*(//|/\*|\*|#|--)' | grep -v '^+++' || echo "(none)"
  echo "== test changes"
  local tests_ok=0
  test_changes "$base" "$ref" || tests_ok=1
  [[ $bad -eq 0 ]] || vfail "path check failed"
  [[ $tests_ok -eq 0 ]] || vfail "existing tests were changed and tests_policy=append-only"
  [[ -f "$CONF/verify.sh" ]] || vfail "missing $CONF/verify.sh"
  need_image "$PROJECT_IMAGE"
  # The checks run the agent's code, so they run offline in a fresh container from a plain tree.
  tree="$out/tree"; /bin/rm -rf "$tree"; mkdir -p "$tree"
  git -C "$REPO" archive "$ref" | tar -x -C "$tree"
  printf '%s\n' "$files" >"$out/changed.txt"
  echo "== checks (offline container)"
  local limit rc=0
  limit="$(verify_timeout)"
  offline -v "$tree:/work" -v "$out/changed.txt:/task/changed.txt:ro" -v "$CONF/verify.sh:/task/verify.sh:ro" \
    "$PROJECT_IMAGE" -- timeout -k 10 "$limit" bash -euo pipefail /task/verify.sh /task/changed.txt 2>&1 |
    tee "$out/verify.log" || rc=$?
  [[ $rc -eq $TIMED_OUT ]] && vfail "checks hit their ${limit}s limit (HUTCH_VERIFY_TIMEOUT / verify_timeout): $out/verify.log"
  [[ $rc -eq 0 ]] || vfail "checks failed: $out/verify.log"
  if [[ ${#unscoped[@]} -gt 0 ]]; then
    echo "passed (warn: ${#unscoped[@]} unscoped)" >"$out/verify.status"
    echo "verify passed (WARN: UNSCOPED_PATHS - ${#unscoped[@]} extra path(s) outside allowlist; review before accepting): git -C $REPO diff $base $ref"
  else
    echo "passed" >"$out/verify.status"
    echo "verify passed: now review the diff yourself: git -C $REPO diff $base $ref"
  fi
}

# run_usage sums what the agents' logs in out directory $1 report: opencode step_finish events and Claude Code result
# events, over every phase's log (run.jsonl and the run.<time>.jsonl files an earlier phase left).
run_usage() {
  python3 -I - "$1" <<'EOF'
import glob, json, os, sys
logs = sorted(glob.glob(os.path.join(sys.argv[1], "run*.jsonl")))
if not logs:
    print("no run logs")
    sys.exit(0)
t = dict(input=0, output=0, reasoning=0, read=0, write=0)
cost = 0.0
secs = 0.0
for log in logs:
    first = last = None
    for line in open(log, errors="replace"):
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if not isinstance(e, dict):
            continue
        ts = e.get("timestamp")
        if isinstance(ts, (int, float)):
            first = ts if first is None else first
            last = ts
        part = e.get("part") or {}
        if e.get("type") == "step_finish" or part.get("type") == "step-finish":
            k = part.get("tokens") or {}
            c = k.get("cache") or {}
            t["input"] += k.get("input", 0); t["output"] += k.get("output", 0); t["reasoning"] += k.get("reasoning", 0)
            t["read"] += c.get("read", 0); t["write"] += c.get("write", 0)
            cost += part.get("cost") or 0
        elif e.get("type") == "result":
            u = e.get("usage") or {}
            t["input"] += u.get("input_tokens", 0); t["output"] += u.get("output_tokens", 0)
            t["read"] += u.get("cache_read_input_tokens", 0); t["write"] += u.get("cache_creation_input_tokens", 0)
            cost += e.get("total_cost_usd") or 0
            secs += (e.get("duration_ms") or 0) / 1000
    if first is not None and last is not None:
        secs += (last - first) / 1000
print("tokens: input %(input)d, output %(output)d, reasoning %(reasoning)d, cache read %(read)d, cache write %(write)d" % t
      + "; cost reported %.2f; agent time %ds" % (cost, secs))
EOF
}

# cmd_report prints one task's outcome for the reviewer and keeps it as report.md: model, exit code, usage, commits,
# verify status, test changes and the files to read. It reads git only in the host repository, never in the agent's
# clone, so it lists commits after hutch export and hutch verify.
cmd_report() {
  need_task "$1"
  local task="$1" dir out base ref
  dir="$(task_dir "$task")"; out="$(out_dir "$task")"; base="$(cat "$dir/base")"; ref="refs/hutch/$task"
  {
    echo "# hutch report: $task"
    echo
    echo "- project: $NAME ($REPO)"
    echo "- base: $base"
    echo "- runs:"
    if [[ -s "$out/models.log" ]]; then sed 's/^/  - /' "$out/models.log"; else echo "  - none"; fi
    echo "- run exit code: $(cat "$out/exit.code" 2>/dev/null || echo 'none')"
    echo "- $(run_usage "$out")"
    echo "- verify: $(cat "$out/verify.status" 2>/dev/null || echo 'not run')"
    echo
    if git -C "$REPO" rev-parse --verify --quiet "$ref" >/dev/null; then
      echo "## Commits"
      echo
      git -C "$REPO" log --format='- %h %s' "$base..$ref"
      echo
      echo "## Diff"
      echo
      echo '```'
      git -C "$REPO" diff --stat "$base" "$ref"
      echo '```'
      echo
      echo "## Test changes"
      echo
      test_changes "$base" "$ref" | sed 's/^/- /' || true
      if [[ -s "$out/unscoped.txt" ]]; then
        echo
        echo "## WARN: UNSCOPED_PATHS"
        echo
        sed 's/^/- /' "$out/unscoped.txt"
      fi
    else
      echo "No commits on the host yet: run hutch export $task, then hutch verify $task."
    fi
    if [[ -s "$out/needs-scope.txt" ]]; then
      echo
      echo "## Requested Scope Escalation"
      echo
      sed 's/^/- /' "$out/needs-scope.txt"
    fi
    echo
    echo "## To review"
    echo
    local f
    for f in sandbox/self-review.md sandbox/design-notes.md verify.log run.err gate.log abort.log needs-scope.txt; do
      [[ -s "$out/$f" && ! -L "$out/$f" ]] && echo "- $out/$f"
    done
    echo "- git -C $REPO diff $base $ref"
  } | tee "$out/report.md"
}

# Isolation probes inside the same sandbox the agent gets. Prints names, never the key's value.
cmd_isolation() {
  need_task "$1"
  need_models
  SANDBOX_CMD=(bash -c '
    probe() { if timeout 8 bash -c "$2" >/dev/null 2>&1; then echo "REACHABLE $1"; else echo "blocked $1"; fi; }
    echo "== egress"
    code=$(curl -s -o /dev/null -w "%{http_code} %{errormsg}" --max-time 15 -H "Authorization: Bearer $HUTCH_PROXY_TOKEN" "$HUTCH_PROBE_URL" -X POST -d "{}")
    echo "model API via gate http=$code"
    code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 6 -H "Authorization: Bearer sk-attacker-account" "$HUTCH_PROBE_URL" -X POST -d "{}")
    echo "spoofed Authorization http=$code"
    code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 6 -H "x-api-key: sk-attacker-account" "$HUTCH_PROBE_URL" -X POST -d "{}")
    echo "spoofed x-api-key http=$code"
    code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 6 "$HUTCH_PROBE_URL" -X POST -d "{}")
    echo "missing auth http=$code"
    code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 6 -H "Authorization: Bearer $HUTCH_PROXY_TOKEN" "${HUTCH_PROBE_URL}/%2e%2e/secret")
    echo "path traversal http=$code"
    code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 6 -H "Authorization: Bearer $HUTCH_PROXY_TOKEN" "${HUTCH_PROBE_URL}?api_key=sk-attacker")
    echo "query credential http=$code"
    code=$(curl -s -o /dev/null -w "%{http_code} %{errormsg}" --max-time 6 "$HUTCH_GATE/")
    echo "other gate path http=$code"
    for u in https://github.com https://proxy.golang.org https://registry.npmjs.org https://pypi.org https://api.anthropic.com https://1.1.1.1; do
      probe "direct $u" "curl -sf --max-time 6 $u"; done
    probe "dns github.com" "getent hosts github.com"
    gw=$(ip route 2>/dev/null | awk "/default/{print \$3}"); gw=${gw:-172.17.0.1}
    for p in 22 80 2375 2376 3306 4222 5432 6379 6380 8222 27017; do
      probe "host.docker.internal:$p" "echo > /dev/tcp/host.docker.internal/$p"
      probe "gateway:$p" "echo > /dev/tcp/$gw/$p"; done
    echo "== identity and mounts"
    id
    grep -vE " (proc|sysfs|cgroup2?|mqueue|devpts|tmpfs|overlay|shm) " /proc/mounts | awk "{print \$2}"
    for d in .ssh .kube .aws .config/gh .docker .pgpass .netrc; do [ -e "$HOME/$d" ] && echo "PRESENT ~/$d"; done
    ls /var/run/docker.sock 2>/dev/null && echo "PRESENT docker.sock"
    echo "== env names"; env | cut -d= -f1 | sort | tr "\n" " "; echo
    if [ -n "${HUTCH_PROXY_TOKEN:-}" ] && [ "${HUTCH_PROXY_TOKEN#hutch-proxy-}" != "$HUTCH_PROXY_TOKEN" ] &&
       [ "${ANTHROPIC_AUTH_TOKEN:-$HUTCH_PROXY_TOKEN}" = "$HUTCH_PROXY_TOKEN" ] &&
       [ "${OPENCODE_API_KEY:-$HUTCH_PROXY_TOKEN}" = "$HUTCH_PROXY_TOKEN" ] &&
       [ -z "${HUTCH_API_KEY:-}${HUTCH_KEY:-}${DEEPSEEK_API_KEY:-}${OPENAI_API_KEY:-}${ANTHROPIC_API_KEY:-}" ]; then
      echo "provider key: not in the sandbox (proxy token only)"; else echo "PRESENT provider key"; fi
    echo "== capabilities"; grep CapEff /proc/self/status
    echo "== kernel"; echo "kernel $(uname -r)"
  ')
  sandbox "$1" -i
}

cmd_smoke() {
  need_task "$1"
  need_models
  if [[ "$AGENT" == opencode ]]; then SANDBOX_CMD=(opencode run --standalone --format json "Reply with exactly: OK")
  else SANDBOX_CMD=(claude -p "Reply with exactly: OK" --output-format json); fi
  # stdin closed: with -i and an open pipe (an agent's shell), opencode run waits on stdin forever.
  sandbox "$1" -i </dev/null
}

# age prints how long ago file $1 changed: 45s, 12m, 3h or 2d.
age() {
  local s; s=$(( $(date +%s) - $(date -r "$1" +%s) ))
  if [[ $s -lt 60 ]]; then echo "${s}s"; elif [[ $s -lt 3600 ]]; then echo "$((s / 60))m"
  elif [[ $s -lt 86400 ]]; then echo "$((s / 3600))h"; else echo "$((s / 86400))d"; fi
}

# cmd_ls prints one line per task. A run is "running" while its gate container is up (every sandbox command has
# one); otherwise it shows the sandbox's exit code. Commits are counted on the host's refs/hutch/<task> (after hutch
# verify): like hutch report, it never runs git in the agent's clone.
cmd_ls() {
  local dir task out running run verify commits model
  [[ -d "${STATE}/work" ]] || { echo "no tasks (hutch new)"; return 0; }
  running="$(docker ps --filter "label=hutch.project=$NAME" --format '{{.Label "hutch.task"}}' 2>/dev/null || true)"
  printf '%-24s %-5s %-12s %-28s %-8s %s\n' TASK AGE RUN VERIFY COMMITS MODEL
  for dir in "${STATE}"/work/*/; do
    task="$(basename "$dir")"
    [[ -f "$dir/base" ]] || continue
    out="$(out_dir "$task")"
    if grep -qx -- "$task" <<<"$running"; then run=running
    elif [[ -f "$out/exit.code" ]]; then run="exit $(cat "$out/exit.code")"
    elif [[ -s "$out/run.jsonl" ]]; then run=stopped
    else run="not run"; fi
    verify="$(head -1 "$out/verify.status" 2>/dev/null || echo '-')"
    commits=-
    git -C "$REPO" rev-parse --verify --quiet "refs/hutch/$task" >/dev/null &&
      commits="$(git -C "$REPO" rev-list --count "$(cat "$dir/base")..refs/hutch/$task")"
    model=-
    [[ -s "$out/models.log" ]] && model="$(tail -1 "$out/models.log" | sed -n 's/.* model=\([^ ]*\).*/\1/p')"
    printf '%-24s %-5s %-12s %-28s %-8s %s\n' "$task" "$(age "$dir/base")" "$run" "$verify" "$commits" "${model:--}"
  done
}

cmd_rm() {
  [[ "${1:-}" =~ ^[a-z0-9-]+$ ]] || die "task name must match [a-z0-9-]+"
  /bin/rm -rf "$(task_dir "$1")" "$(out_dir "$1")"
  git -C "$REPO" update-ref -d "refs/hutch/$1" 2>/dev/null || true
}

cmd_models() {
  echo "provider $PROVIDER ($MODELS_FILE):"
  grep -v '^#' "$MODELS_FILE"
  echo "skipped (${HUTCH_HOME}/skip):"
  cat "${HUTCH_HOME}/skip" 2>/dev/null || true
}

usage() { sed -n '2,/^# Agents:/p' "${HUTCH_DIR}/hutch"; }

# All code lives in functions and main runs last, so bash has parsed the whole file before anything executes: a git
# pull that rewrites this file during a long run cannot change the running command.
main() {
  setup_provider
  [[ $# -gt 0 ]] || { usage; exit 2; }
  local cmd="$1"; shift
  case "$cmd" in
    status) cmd_status ;;
    models) cmd_models ;;
    help|-h|--help) usage ;;
    init) cmd_init "${1:-}" ;;
    build) cmd_build ;;
    *)
      need_project
      setup_runtime
      case "$cmd" in
        new) cmd_new "$@" ;;
        run) cmd_run "$@" ;;
        batch) cmd_batch "$@" ;;
        say) [[ $# -eq 2 ]] || die "usage: hutch say <task> <message>"; cmd_say "$@" ;;
        shell) cmd_shell "$@" ;;
        export) cmd_export "${1:-}" ;;
        verify) cmd_verify "$@" ;;
        rm) cmd_rm "${1:-}" ;;
        ls) cmd_ls ;;
        isolation) cmd_isolation "${1:-}" ;;
        smoke) cmd_smoke "${1:-}" ;;
        report) cmd_report "${1:-}" ;;
        needs-pro) need_task "${1:-}"; needs_pro "$(task_dir "$1")/allow" "$(task_dir "$1")/opened" ;;
        *) usage; exit 2 ;;
      esac ;;
  esac
}

[[ "${HUTCH_LIB:-}" == 1 ]] || main "$@"

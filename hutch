#!/usr/bin/env bash
# hutch: a coding agent (opencode or Claude Code) does one bounded task in an isolated container; the host agent briefs and verifies.
#   hutch status                     machine and project state; start here (exit 3: project not set up, 4: machine not set up)
#   hutch init [--in-repo]           create this project's config from the template (~/.hutch/projects/<name>, or <repo>/.hutch)
#   hutch build                      build the base and project images, pull the gate, create the networks
#   hutch new <task> <allow> <brief> clone the base branch (or $HUTCH_BRANCH) into a task workspace
#   hutch run <task>                 run the agent on the primer and brief (log in the task's out directory)
#   hutch say <task> <message>       follow-up message (opencode: after the run ends; claude: during the run)
#   hutch shell <task>               interactive agent session in the sandbox
#   hutch export <task>              write the task branch as a git bundle
#   hutch verify <task>              fetch the bundle on the host, check paths, run the project's checks offline
#   hutch report <task>              the task's model, usage, commits, verify status and test changes (report.md)
#   hutch rm <task>                  remove a task workspace, its output and its ref
#   hutch smoke|isolation <task>     one-line model call | egress, mount and capability probes
#   hutch models                     the model chosen per HUTCH_KIND and the skipped models
#   hutch needs-pro <task>           why a task needs a strong model (exit 1: it does not)
# Agents: read AGENTS.md next to this script before using it.
# Path rules match unquoted globs on purpose (SC2053); the isolation probe is a literal script (SC2016).
# shellcheck disable=SC2053,SC2016,SC2012
set -euo pipefail

HUTCH_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
HUTCH_HOME="${HUTCH_HOME:-${HOME}/.hutch}"
BASE_IMAGE=hutch-base:latest
# The gate: nginx, unprivileged, pinned by digest. It holds the provider key for one sandbox command and forwards only
# the provider's API paths; the sandbox has no other way out.
GATE_IMAGE=nginxinc/nginx-unprivileged:1.27.5-alpine@sha256:65e3e85dbaed8ba248841d9d58a899b6197106c23cb0ff1a132b7bfe0547e4c0
NET_INTERNAL=hutch-internal
NET_EGRESS=hutch-egress
# The key the agents see: a placeholder, replaced by the gate.
PLACEHOLDER_KEY=hutch-gate
# Kinds in the model tables that count as strong models for the pro-paths rule.
PRO_KINDS="design concurrency"

die() { echo "hutch: $*" >&2; exit 1; }

# ---- provider, agent and model -------------------------------------------------------------------------------

# kv_get prints the value of key $2 from key=value file $1 (the file is read, never executed; the first line wins).
kv_get() {
  awk -v k="$2" 'index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }' "$1"
}

# setup_provider reads providers/<name>.conf, or ~/.hutch/providers/<name>.conf first, for HUTCH_PROVIDER (default
# opencode), and checks the values that end up in the gate's nginx configuration.
setup_provider() {
  local file p
  PROVIDER="${HUTCH_PROVIDER:-opencode}"
  [[ "$PROVIDER" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "HUTCH_PROVIDER must match [a-z0-9][a-z0-9-]*"
  file="${HUTCH_HOME}/providers/${PROVIDER}.conf"
  [[ -f "$file" ]] || file="${HUTCH_DIR}/providers/${PROVIDER}.conf"
  [[ -f "$file" ]] || die "no provider '$PROVIDER': add ${HUTCH_HOME}/providers/${PROVIDER}.conf (see ${HUTCH_DIR}/providers)"
  UPSTREAM="$(kv_get "$file" upstream)"
  [[ "$UPSTREAM" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?$ ]] ||
    die "$file: upstream must be https://host[:port] with no path, got '$UPSTREAM'"
  KEY_ITEM="${HUTCH_KEY_ITEM:-$(kv_get "$file" key_item)}"
  [[ -n "$KEY_ITEM" ]] || die "$file: key_item is empty"
  PATHS="$(kv_get "$file" paths)"
  [[ -n "$PATHS" ]] || die "$file: paths is empty"
  for p in $PATHS; do [[ "$p" =~ ^/[A-Za-z0-9._/-]*$ ]] || die "$file: paths must be /path prefixes, got '$p'"; done
  CLAUDE_BASE="$(kv_get "$file" claude_base)"
  OPENCODE_BASE="$(kv_get "$file" opencode_base)"
  OPENCODE_PROVIDER="$(kv_get "$file" opencode_provider)"
  for p in "$CLAUDE_BASE" "$OPENCODE_BASE"; do
    [[ -z "$p" || "$p" =~ ^/[A-Za-z0-9._/-]*$ ]] || die "$file: claude_base and opencode_base must be /paths"
  done
  [[ -z "$OPENCODE_PROVIDER" || "$OPENCODE_PROVIDER" =~ ^[a-z0-9-]+$ ]] || die "$file: opencode_provider is not an id"
  COMPACT_WINDOW="${HUTCH_COMPACT_WINDOW:-$(kv_get "$file" compact_window)}"
  p="$(kv_get "$file" models)"
  [[ -z "$p" || "$p" == /* ]] || p="$(dirname "$file")/$p"
  [[ -n "$p" ]] || p="${HUTCH_DIR}/models/${PROVIDER}.tsv"
  MODELS_FILE="${HUTCH_MODELS:-$(cd "$(dirname "$p")" 2>/dev/null && pwd)/$(basename "$p")}"
  AGENT="${HUTCH_AGENT:-opencode}"
  case "$AGENT" in
    opencode) [[ -n "$OPENCODE_PROVIDER" && -n "$OPENCODE_BASE" ]] ||
      die "provider $PROVIDER has no opencode_provider / opencode_base: use HUTCH_AGENT=claude" ;;
    claude) [[ -n "$CLAUDE_BASE" ]] || die "provider $PROVIDER has no claude_base: use HUTCH_AGENT=opencode" ;;
    *) die "HUTCH_AGENT must be opencode or claude" ;;
  esac
  KIND="${HUTCH_KIND:-}"
  [[ -z "$KIND" && "${HUTCH_PHASE:-}" == design ]] && KIND=design
  MODEL="${HUTCH_MODEL:-}"
  SMALL_MODEL="${HUTCH_SMALL_MODEL:-}"
}

# kinds lists the HUTCH_KIND values the model table defines.
kinds() { awk -F'\t' '!/^#/ && NF > 1 && $1 != "small" { printf "%s%s", sep, $1; sep = ", " }' "$MODELS_FILE"; }

# pick_model prints the first model of a table row that ~/.hutch/skip does not list (one model per line there).
pick_model() {
  local row m
  row="$(awk -F'\t' -v k="$1" '$1 == k { print $2 }' "$MODELS_FILE")"
  [[ -n "$row" ]] || die "$(basename "$MODELS_FILE") has no kind '$1' ($(kinds))"
  for m in $row; do
    grep -qxF "$m" "${HUTCH_HOME}/skip" 2>/dev/null || { echo "$m"; return; }
  done
  die "every model for '$1' is in ${HUTCH_HOME}/skip"
}

# need_models resolves MODEL and SMALL_MODEL for a command that talks to a model.
need_models() {
  if [[ -z "$MODEL" ]]; then
    [[ -n "$KIND" ]] || die "set HUTCH_KIND ($(kinds)) or HUTCH_MODEL"
    MODEL="$(pick_model "$KIND")"
  fi
  [[ -n "$SMALL_MODEL" ]] || SMALL_MODEL="$(pick_model small)"
}

# api_key prints the provider key: HUTCH_API_KEY, else the macOS keychain, else the Secret Service (Linux).
api_key() {
  if [[ -n "${HUTCH_API_KEY:-}" ]]; then echo "$HUTCH_API_KEY"; return; fi
  if command -v security >/dev/null; then
    security find-generic-password -s "$KEY_ITEM" -w 2>/dev/null && return
  elif command -v secret-tool >/dev/null; then
    secret-tool lookup service "$KEY_ITEM" 2>/dev/null && return
  fi
  die "no API key: store it as '$KEY_ITEM' (AGENTS.md, Machine setup) or set HUTCH_API_KEY"
}

have_key() {
  [[ -n "${HUTCH_API_KEY:-}" ]] && return 0
  if command -v security >/dev/null; then security find-generic-password -s "$KEY_ITEM" >/dev/null 2>&1; return; fi
  command -v secret-tool >/dev/null && [[ -n "$(secret-tool lookup service "$KEY_ITEM" 2>/dev/null)" ]]
}

# ---- project ---------------------------------------------------------------------------------------------------

# conf_get prints the value of key $1 from the project config.
conf_get() { kv_get "$CONF/config" "$1"; }

slug() { echo "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-\n' '-'; }

# resolve_project sets REPO (the main checkout, also from a worktree), NAME and CONF; CONF is empty when not set up.
resolve_project() {
  local common
  CONF=""
  if [[ -n "${HUTCH_PROJECT:-}" ]]; then
    NAME="$(slug "$HUTCH_PROJECT")"
    [[ -f "${HUTCH_HOME}/projects/${NAME}/config" ]] && CONF="${HUTCH_HOME}/projects/${NAME}"
    REPO=""
    [[ -n "$CONF" ]] && REPO="$(conf_get repo)"
    [[ -n "$REPO" ]] || die "HUTCH_PROJECT=$NAME needs ${HUTCH_HOME}/projects/${NAME}/config with a repo= line"
  else
    common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ||
      die "not inside a git repository (or set HUTCH_PROJECT)"
    REPO="$(dirname "$common")"
    NAME="$(slug "$(basename "$REPO")")"
    if [[ -f "$REPO/.hutch/config" ]]; then CONF="$REPO/.hutch"
    elif [[ -f "${HUTCH_HOME}/projects/${NAME}/config" ]]; then CONF="${HUTCH_HOME}/projects/${NAME}"; fi
  fi
  if [[ -n "$CONF" ]]; then
    local n; n="$(conf_get name)"
    [[ -n "$n" ]] && NAME="$n"
    [[ "$NAME" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "project name '$NAME' must match [a-z0-9][a-z0-9-]*"
  fi
  STATE="${HUTCH_HOME}/state/${NAME}"
  PROJECT_IMAGE="hutch-${NAME}:latest"
  CACHE_VOLUME="hutch-${NAME}-cache"
  CLAUDE_VOLUME="hutch-${NAME}-claude"
}

# try_resolve resolves the project when that works and fails quietly otherwise (resolve_project exits on errors).
try_resolve() { (resolve_project) >/dev/null 2>&1 && resolve_project; }

need_project() {
  resolve_project
  [[ -n "$CONF" ]] && return
  echo "hutch: project '$NAME' ($REPO) is not set up: there is no $REPO/.hutch/config or ${HUTCH_HOME}/projects/$NAME/config." >&2
  echo "Agents: stop here and follow \"Project setup\" in ${HUTCH_DIR}/AGENTS.md, asking the user its questions, before any other hutch command." >&2
  exit 3
}

base_branch() { local b; b="$(conf_get base_branch)"; echo "${b:-main}"; }

task_dir() { echo "${STATE}/work/$1"; }
out_dir() { echo "${STATE}/out/$1"; }

need_task() {
  [[ -n "${1:-}" && "$1" =~ ^[a-z0-9-]+$ ]] || die "task name must match [a-z0-9-]+"
  [[ -d "$(task_dir "$1")/repo" ]] || die "no workspace for $1 (hutch new)"
}

# patterns prints the non-comment lines of a pattern file; a missing file prints nothing.
patterns() { [[ -f "$1" ]] || return 0; grep -v -e '^[[:space:]]*$' -e '^#' "$1" || true; }

# ---- path rules ------------------------------------------------------------------------------------------------

# Paths the agent may never change, whatever the project or task says: the project's hutch config itself, and every
# .gitattributes, because verify checks a git archive of the task branch and export-ignore in any directory would
# hide files from the checks.
ALWAYS_PROTECTED='.hutch/*
.gitattributes
*/.gitattributes'

# opened succeeds when protected pattern $1 is openable in this project and the task's opened file lists it.
opened() {
  local p="$1" o
  [[ -f "$OPENED_FILE" ]] || return 1
  grep -qxF -- "$p" "$OPENED_FILE" || return 1
  while IFS= read -r o; do [[ "$p" == "$o" ]] && return 0; done < <(patterns "$CONF/openable")
  return 1
}

protected() {
  local f="$1" p
  while IFS= read -r p; do [[ "$f" == $p ]] && return 0; done <<<"$ALWAYS_PROTECTED"
  while IFS= read -r p; do
    [[ "$f" == $p ]] && ! opened "$p" && return 0
  done < <(patterns "$CONF/protected")
  return 1
}

allowed() {
  local f="$1" p
  while IFS= read -r p; do [[ "$f" == $p ]] && return 0; done < <(patterns "$ALLOW_FILE")
  return 1
}

# needs_pro prints why a task (allow file $1, opened file $2) needs a strong model and succeeds. The rule is on only
# when the project has a pro-paths file. An allow pattern needs one when it and a pro-paths line match either way, so
# both a narrow allow inside a sensitive area and a broad allow that covers one are caught.
needs_pro() {
  local allow="$1" opened_file="$2" p g
  [[ -n "$(patterns "$CONF/pro-paths")" ]] || return 1
  [[ -s "$opened_file" ]] && { echo "opens protected paths ($(tr '\n' ' ' <"$opened_file"))"; return 0; }
  while IFS= read -r p; do
    while IFS= read -r g; do
      if [[ "$p" == $g || "$g" == $p ]]; then echo "may change sensitive code ($p, pro-paths: $g)"; return 0; fi
    done < <(patterns "$CONF/pro-paths")
  done < <(patterns "$allow")
  return 1
}

# Test files when the project config has no tests= pattern (an ERE over repository paths).
DEFAULT_TESTS='(^|/)(tests?|__tests__|specs?)/|[._-](test|spec)\.[A-Za-z0-9]+$|_test\.go$|(^|/)test_[^/]*\.py$'
# Added lines that skip or focus tests, in the common frameworks.
SKIP_MARKERS='\.(skip|only|todo)\(|(^|[^A-Za-z0-9_])(xit|xdescribe|xtest|fit|fdescribe)\(|t\.Skip|@pytest\.mark\.(skip|xfail)|@unittest\.skip|@Disabled|@Ignore|#\[ignore\]'

# test_changes names what a task did to the project's tests between commits $1 and $2: deleted test files, lines
# removed from existing ones, added skip or focus markers, and new test files. A cheap model that cannot make a test
# pass may weaken it instead, and the checks would still pass. With tests_policy=append-only any of those fails.
test_changes() {
  local base="$1" ref="$2" re policy st f n skips bad=0
  re="$(conf_get tests)"; re="${re:-$DEFAULT_TESTS}"
  policy="$(conf_get tests_policy)"; policy="${policy:-report}"
  [[ "$policy" == report || "$policy" == append-only ]] || die "tests_policy must be report or append-only"
  while IFS=$'\t' read -r st f; do
    if [[ -z "$f" ]] || ! grep -qE -- "$re" <<<"$f"; then continue; fi
    case "$st" in
      D) echo "DELETED $f"; bad=1; continue ;;
      A) echo "new $f" ;;
      *) n="$(git -C "$REPO" diff --numstat --no-renames "$base" "$ref" -- "$f" | awk '{ print $1 " " $2 }')"
         if [[ "${n#* }" != 0 ]]; then echo "EDITED $f (-${n#* })"; bad=1; else echo "extended $f (+${n% *})"; fi ;;
    esac
    skips="$(git -C "$REPO" diff -U0 --no-renames "$base" "$ref" -- "$f" | grep -E '^\+' | grep -v '^+++' |
      grep -E -- "$SKIP_MARKERS" || true)"
    if [[ -n "$skips" ]]; then
      while IFS= read -r n; do echo "SKIP $f: ${n#+}"; done <<<"$skips"
      bad=1
    fi
  done < <(git -C "$REPO" diff --name-status --no-renames "$base" "$ref")
  [[ $bad -eq 1 ]] || echo "(no changes to existing tests)"
  [[ "$policy" == append-only && $bad -eq 1 ]] && return 1
  return 0
}

need_pro_kind() {
  local dir reason k pro=" "
  dir="$(task_dir "$1")"
  reason="$(needs_pro "$dir/allow" "$dir/opened")" || return 0
  for k in $PRO_KINDS; do pro+="$(awk -F'\t' -v k="$k" '$1 == k { print $2 }' "$MODELS_FILE") "; done
  [[ "$pro" == *" $MODEL "* ]] && return 0
  die "task $1 $reason; run it with HUTCH_KIND set to one of: $PRO_KINDS (a strong model)"
}

# ---- runtime (Docker) ------------------------------------------------------------------------------------------

need_docker() { docker info >/dev/null 2>&1 || die "docker is not running"; }

need_image() { docker image inspect "$1" >/dev/null 2>&1 || die "image $1 is missing; run hutch build"; }

# gate_conf prints the gate's nginx template: one location per allowed path prefix, forwarded to the upstream over
# verified TLS with the key set from the gate's own environment (${HUTCH_KEY}, filled in by the image's envsubst at
# start, so the key is never written to disk), and 403 for every other path.
gate_conf() {
  local host="${UPSTREAM#https://}" p
  printf '%s\n' \
    'log_format hutch_gate '"'"'$time_iso8601 $request_method $request_uri -> $status upstream=$upstream_status'"'"';' \
    'server {' \
    '  listen 8080;' \
    '  access_log /dev/stdout hutch_gate;' \
    '  client_max_body_size 64m;' \
    '  location = /hutch-gate-health { access_log off; return 200 "ok\n"; }'
  for p in $PATHS; do
    printf '%s\n' \
      "  location ^~ $p {" \
      "    proxy_pass $UPSTREAM;" \
      "    proxy_ssl_server_name on;" \
      "    proxy_ssl_name ${host%%:*};" \
      "    proxy_ssl_verify on;" \
      "    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;" \
      "    proxy_set_header Host $host;" \
      '    proxy_set_header Authorization "Bearer ${HUTCH_KEY}";' \
      '    proxy_set_header x-api-key "${HUTCH_KEY}";' \
      "    proxy_http_version 1.1;" \
      "    proxy_buffering off;" \
      "    proxy_request_buffering off;" \
      "    proxy_read_timeout 900s;" \
      "  }"
  done
  printf '%s\n' '  location / { return 403 "hutch gate: path not allowed\n"; }' '}'
}

# gate_up starts gate $1 for one sandbox command with the provider key, writes its template to file $2, and waits
# until it answers. gate_down (also run on exit) appends its access log to file $3 and removes it.
gate_up() {
  local name="$1" conf="$2" key _
  key="$(api_key)"
  gate_conf >"$conf"
  GATE_NAME="$name"; GATE_LOG="$3"
  trap gate_down EXIT
  HUTCH_KEY="$key" docker run -d --rm --name "$name" --network "$NET_EGRESS" --cap-drop ALL \
    --security-opt no-new-privileges --read-only --tmpfs /tmp:mode=1777 --tmpfs /etc/nginx/conf.d:mode=1777 \
    --memory 256m --pids-limit 64 -e HUTCH_KEY -v "$conf:/etc/nginx/templates/default.conf.template:ro" \
    "$GATE_IMAGE" >/dev/null
  docker network connect "$NET_INTERNAL" "$name"
  for _ in $(seq 1 50); do
    docker exec "$name" wget -q -O /dev/null http://127.0.0.1:8080/hutch-gate-health 2>/dev/null && return 0
    sleep 0.2
  done
  docker logs "$name" >&2 2>&1 || true
  die "the gate $name did not start (log above)"
}

gate_down() {
  [[ -n "${GATE_NAME:-}" ]] || return 0
  docker logs "$GATE_NAME" >>"$GATE_LOG" 2>&1 || true
  docker rm -f "$GATE_NAME" >/dev/null 2>&1 || true
  GATE_NAME=""
}

cache_args() {
  local m; m="$(conf_get cache_mount)"
  [[ -n "$m" ]] && echo "-v ${CACHE_VOLUME}:${m}"
  return 0
}

# limit_args prints the process and memory limits for every container that runs the agent's code.
limit_args() {
  local pids mem
  pids="${HUTCH_PIDS:-$(conf_get pids)}"; mem="${HUTCH_MEMORY:-$(conf_get memory)}"
  echo "--pids-limit ${pids:-2048} --memory ${mem:-12g}"
}

# seconds prints a time limit: environment variable $1, else config key $2, else default $3.
seconds() {
  local v="${!1:-}"
  [[ -n "$v" ]] || v="$(conf_get "$2")"
  v="${v:-$3}"
  [[ "$v" =~ ^[0-9]+$ ]] || die "$1 / $2 must be whole seconds, got '$v'"
  echo "$v"
}
run_timeout() { seconds HUTCH_RUN_TIMEOUT run_timeout 3600; }
verify_timeout() { seconds HUTCH_VERIFY_TIMEOUT verify_timeout 1800; }

# TIMED_OUT is the exit code of coreutils timeout when the limit is reached; the agent and the checks run under it
# inside the container, so a stuck run or check ends instead of holding the sandbox and the model quota.
TIMED_OUT=124

# opencode_json prints the opencode configuration for one run: the provider's base URL points at the gate.
opencode_json() {
  printf '%s\n' '{' \
    '  "$schema": "https://opencode.ai/config.json",' \
    '  "update": "disable",' \
    '  "share": "disabled",' \
    "  \"model\": \"$OPENCODE_PROVIDER/$MODEL\"," \
    "  \"small_model\": \"$OPENCODE_PROVIDER/$SMALL_MODEL\"," \
    "  \"agent\": { \"general\": { \"model\": \"$OPENCODE_PROVIDER/$MODEL\" }, \"explore\": { \"model\": \"$OPENCODE_PROVIDER/$SMALL_MODEL\" } }," \
    "  \"provider\": { \"$OPENCODE_PROVIDER\": { \"options\": { \"baseURL\": \"$1\", \"apiKey\": \"$PLACEHOLDER_KEY\" } } }" \
    '}'
}

# sandbox runs SANDBOX_CMD in the project image: internal network with no route out, the gate as the only peer (it
# holds the key), no capabilities, only the task's files mounted. Extra docker flags come in "$@".
sandbox() {
  local task="$1"; shift
  local dir out gate url probe agent_args extra
  dir="$(task_dir "$task")"; out="$(out_dir "$task")"
  [[ -f "$CONF/primer.md" ]] || die "missing $CONF/primer.md"
  need_image "$PROJECT_IMAGE"
  need_image "$GATE_IMAGE"
  # Model names go into opencode.json; brackets stay allowed for names such as deepseek-v4-pro[1m].
  local model_re='^[][A-Za-z0-9._:/-]+$'
  [[ "$MODEL" =~ $model_re && "$SMALL_MODEL" =~ $model_re ]] || die "model names may hold only letters, digits and ._:/-[]"
  gate="hutch-gate-${NAME}-${task}-$$"; url="http://${gate}:8080"
  gate_up "$gate" "$dir/gate.conf.template" "$out/gate.log"
  if [[ -n "$CLAUDE_BASE" ]]; then probe="$url$CLAUDE_BASE/v1/messages"; else probe="$url$OPENCODE_BASE/chat/completions"; fi
  if [[ "$AGENT" == opencode ]]; then
    # Sessions live with the task, so a follow-up (hutch say) continues the same session.
    mkdir -p "$dir/oc-data"
    opencode_json "$url$OPENCODE_BASE" >"$dir/opencode.json"
    agent_args=(-v "$dir/oc-data:/home/hutch/.local/share/opencode"
      -v "$dir/opencode.json:/home/hutch/.config/opencode/opencode.json:ro"
      -v "${HUTCH_DIR}/rules/sandbox.md:/home/hutch/.config/opencode/AGENTS.md:ro"
      -e OPENCODE_API_KEY="$PLACEHOLDER_KEY")
  else
    agent_args=(-v "${CLAUDE_VOLUME}:/home/hutch/.claude" -v "${HUTCH_DIR}/rules/sandbox.md:/home/hutch/.claude/CLAUDE.md:ro"
      -e ANTHROPIC_AUTH_TOKEN="$PLACEHOLDER_KEY" -e ANTHROPIC_BASE_URL="$url$CLAUDE_BASE"
      -e ANTHROPIC_MODEL="$MODEL" -e ANTHROPIC_DEFAULT_OPUS_MODEL="$MODEL"
      -e ANTHROPIC_DEFAULT_SONNET_MODEL="$MODEL" -e ANTHROPIC_DEFAULT_HAIKU_MODEL="$SMALL_MODEL"
      -e CLAUDE_CODE_SUBAGENT_MODEL="$SMALL_MODEL" -e CLAUDE_CODE_EFFORT_LEVEL="${HUTCH_EFFORT:-max}"
      -e CLAUDE_CONFIG_DIR=/home/hutch/.claude)
    [[ -n "$COMPACT_WINDOW" ]] && agent_args+=(-e CLAUDE_CODE_AUTO_COMPACT_WINDOW="$COMPACT_WINDOW")
  fi
  extra=()
  [[ -f "$CONF/checklist.md" ]] && extra+=(-v "$CONF/checklist.md:/task/project-checklist.md:ro")
  [[ -f "$CONF/protected" ]] && extra+=(-v "$CONF/protected:/task/protected.txt:ro")
  [[ -f "$dir/opened" ]] && extra+=(-v "$dir/opened:/task/opened.txt:ro")
  local rc=0
  # shellcheck disable=SC2046 # cache_args and limit_args print whole docker flags
  docker run --rm "$@" \
    --network "$NET_INTERNAL" --cap-drop ALL --security-opt no-new-privileges \
    $(limit_args) --tmpfs /tmp:exec,size=4g \
    -v "$dir/repo:/work" -v "$dir/brief.md:/task/brief.md:ro" -v "$CONF/primer.md:/task/primer.md:ro" \
    -v "${HUTCH_DIR}/rules/checklist.md:/task/checklist.md:ro" -v "$out:/out" \
    ${extra[@]+"${extra[@]}"} $(cache_args) "${agent_args[@]}" -e HUTCH_PROBE_URL="$probe" -e HUTCH_GATE="$url" \
    "$PROJECT_IMAGE" "${SANDBOX_CMD[@]}" || rc=$?
  gate_down
  return "$rc"
}

# offline runs a command in the project image with no network at all, under the same limits as the agent: the
# checks run the agent's code.
offline() {
  # shellcheck disable=SC2046
  docker run --rm --network none --cap-drop ALL --security-opt no-new-privileges --tmpfs /tmp:exec,size=4g \
    $(limit_args) $(cache_args) "$@"
}

# ---- commands --------------------------------------------------------------------------------------------------

line() { printf '  %-22s %s\n' "$1" "$2"; }

cmd_status() {
  local rc=0 ok
  echo "hutch ${HUTCH_DIR} ($(git -C "$HUTCH_DIR" rev-parse --short HEAD 2>/dev/null || echo 'not a git checkout'))"
  echo "provider: $PROVIDER ($UPSTREAM), agent: $AGENT"
  echo "machine:"
  if docker info >/dev/null 2>&1; then line docker ok; else line docker "MISSING (start Docker)"; rc=4; fi
  if have_key; then line "key $KEY_ITEM" ok; else line "key $KEY_ITEM" "MISSING (AGENTS.md, Machine setup)"; rc=4; fi
  for ok in "$BASE_IMAGE" "$GATE_IMAGE"; do
    if docker image inspect "$ok" >/dev/null 2>&1; then line "$ok" ok; else line "$ok" "MISSING (hutch build)"; rc=4; fi
  done
  command -v hutch >/dev/null || echo "  hutch is not on PATH (optional: ln -s ${HUTCH_DIR}/hutch ~/.local/bin/hutch)"
  echo "project:"
  if ! try_resolve; then echo "  not inside a git repository (or HUTCH_PROJECT has no config)"; return "$rc"; fi
  line name "$NAME"
  line repo "$REPO"
  if [[ -z "$CONF" ]]; then
    line config "NOT SET UP (follow \"Project setup\" in ${HUTCH_DIR}/AGENTS.md)"
    [[ $rc -eq 0 ]] && rc=3
    return "$rc"
  fi
  line config "$CONF"
  if docker image inspect "$PROJECT_IMAGE" >/dev/null 2>&1; then line image "$PROJECT_IMAGE ok"
  else line image "$PROJECT_IMAGE MISSING (hutch build)"; [[ $rc -eq 0 ]] && rc=4; fi
  line tasks "$(ls "${STATE}/work" 2>/dev/null | tr '\n' ' ')"
  return "$rc"
}

cmd_init() {
  local dest
  resolve_project
  [[ -z "$CONF" ]] || die "already set up: $CONF"
  if [[ "${1:-}" == --in-repo ]]; then dest="$REPO/.hutch"; else dest="${HUTCH_HOME}/projects/${NAME}"; fi
  [[ ! -e "$dest" ]] || die "$dest exists"
  mkdir -p "$dest"
  /bin/cp -R "${HUTCH_DIR}/template/." "$dest/"
  { echo "name=$NAME"; [[ "$dest" == "$REPO/.hutch" ]] || echo "repo=$REPO"; } >>"$dest/config"
  echo "created $dest; fill in every file there (AGENTS.md, Project setup), then run hutch build"
}

cmd_build() {
  need_docker
  docker build -t "$BASE_IMAGE" --build-arg HUTCH_UID="$(id -u)" --build-arg HUTCH_GID="$(id -g)" "${HUTCH_DIR}/image"
  docker pull -q "$GATE_IMAGE" >/dev/null
  docker network inspect "$NET_INTERNAL" >/dev/null 2>&1 || docker network create --internal "$NET_INTERNAL" >/dev/null
  docker network inspect "$NET_EGRESS" >/dev/null 2>&1 || docker network create "$NET_EGRESS" >/dev/null
  # The allowlist proxy of earlier versions held no key but is no longer used: the gate replaced it.
  docker rm -f hutch-proxy >/dev/null 2>&1 || true
  CONF=""
  try_resolve || true
  if [[ -z "$CONF" ]]; then echo "base image and gate ready; no project here is set up, so no project image"; return; fi
  local re files branch
  BUILD_CTX="$(mktemp -d)"
  trap 'rm -rf "$BUILD_CTX"' EXIT
  mkdir "$BUILD_CTX/src"
  re="$(conf_get manifests)"
  branch="${HUTCH_BRANCH:-$(base_branch)}"
  # Dependency manifests only, from the committed base branch or $HUTCH_BRANCH, the branch tasks will clone: the
  # image changes when dependencies do, and a task on a branch that adds one still builds offline.
  if [[ -n "$re" ]]; then
    files="$(git -C "$REPO" ls-tree -r --name-only "$branch" | grep -E -- "$re" || true)"
    [[ -n "$files" ]] || die "manifests=$re matches no file on $branch"
    # shellcheck disable=SC2086 # one path per line, no spaces in manifest paths
    git -C "$REPO" archive "$branch" -- $files | tar -x -C "$BUILD_CTX/src"
  fi
  /bin/cp -f "$CONF/Dockerfile" "$BUILD_CTX/Dockerfile"
  docker build -t "$PROJECT_IMAGE" --build-arg HUTCH_BASE="$BASE_IMAGE" "$BUILD_CTX"
}

cmd_new() {
  local task="$1" allow="$2" brief="$3" dir
  [[ "$task" =~ ^[a-z0-9-]+$ ]] || die "task name must match [a-z0-9-]+"
  [[ -f "$allow" && -f "$brief" ]] || die "allow and brief files must exist"
  dir="$(task_dir "$task")"
  [[ ! -e "$dir" ]] || die "$dir exists"
  mkdir -p "$dir" "$(out_dir "$task")"
  git clone --quiet --no-local --single-branch --branch "${HUTCH_BRANCH:-$(base_branch)}" "$REPO" "$dir/repo"
  git -C "$dir/repo" remote remove origin
  git -C "$dir/repo" switch --quiet -c "hutch/$task"
  git -C "$dir/repo" config user.name "hutch agent"
  git -C "$dir/repo" config user.email "hutch@localhost"
  git -C "$dir/repo" rev-parse HEAD >"$dir/base"
  /bin/cp -f "$allow" "$dir/allow"
  /bin/cp -f "$brief" "$dir/brief.md"
  if [[ -n "${HUTCH_OPENED:-}" ]]; then /bin/cp -f "$HUTCH_OPENED" "$dir/opened"; echo "opened: $(tr '\n' ' ' <"$dir/opened")"; fi
  echo "workspace $dir at $(cat "$dir/base")"
}

# user_line prints one stream-json user message (Claude Code agent).
user_line() {
  python3 -I -c 'import json, sys; print(json.dumps({"type": "user", "message": {"role": "user", "content": [{"type": "text", "text": sys.argv[1]}]}}))' "$1"
}

# run_idle is true when the log's last event is a result, the log has not changed for HUTCH_IDLE_S seconds (default
# 120) and no message was sent after it. A background task's notification also ends in a result, so counting results
# per message does not work.
run_idle() {
  python3 -I - "$1" "$2" "${HUTCH_IDLE_S:-120}" <<'EOF'
import json, os, sys, time
log, steer, idle = sys.argv[1], sys.argv[2], int(sys.argv[3])
last = None
for line in open(log):
    try:
        last = json.loads(line).get("type")
    except ValueError:
        last = None
quiet = time.time() - os.path.getmtime(log) >= idle
sys.exit(0 if last == "result" and quiet and os.path.getmtime(steer) <= os.path.getmtime(log) else 1)
EOF
}

kickoff() {
  case "${HUTCH_PHASE:-}" in
    design) echo "PHASE 1 (design only). Read /task/primer.md, /task/brief.md, /task/checklist.md and /task/project-checklist.md if it exists, then the sources the brief names. Write /out/design-notes.md exactly as the checklist's 'Design notes' section says. Do not change any file under /work, run no generator and commit nothing. Then stop with a two-line report." ;;
    build) echo "PHASE 2 (build). Read /task/primer.md, /task/brief.md, /task/checklist.md, /task/project-checklist.md if it exists, and /out/design-notes.md; its 'Reviewer notes' section, if present, overrides the notes. Complete the task under your sandbox rules, following the design notes." ;;
    "") echo "Read /task/primer.md, then /task/brief.md, /task/checklist.md and /task/project-checklist.md if it exists, and complete the task under your sandbox rules." ;;
    *) die "HUTCH_PHASE must be design or build" ;;
  esac
}

# The Claude Code session reads stream-json from steer.jsonl through tail, so hutch say reaches it mid-run. When the
# session is idle (run_idle) or the sandbox has exited, tail is stopped and stdin closes, which ends the session.
cmd_run() {
  need_task "$1"
  need_models
  need_pro_kind "$1"
  local task="$1" out steer tailpid msg limit
  out="$(out_dir "$task")"; steer="$out/steer.jsonl"
  msg="$(kickoff)"
  limit="$(run_timeout)"
  /bin/rm -f "$out/tail.pid" "$out/exit.code"
  # A later phase keeps the earlier phase's log.
  [[ -s "$out/run.jsonl" ]] && /bin/mv -f "$out/run.jsonl" "$out/run.$(date +%Y%m%d%H%M%S).jsonl"
  : >"$out/run.jsonl"
  echo "$(date -u +%FT%TZ) agent=$AGENT provider=$PROVIDER kind=$KIND model=$MODEL small=$SMALL_MODEL phase=${HUTCH_PHASE:-}" >>"$out/models.log"
  if [[ "$AGENT" == opencode ]]; then
    # opencode run takes one message and exits when the agent stops; hutch say continues the session afterwards.
    : >"$steer"
    SANDBOX_CMD=(timeout -k 30 "$limit" opencode run --standalone --auto --format json --title "$task" "$msg")
    local rc=0
    sandbox "$task" >"$out/run.jsonl" 2>"$out/run.err" || rc=$?
    echo "$rc" >"$out/exit.code"
    echo "log: $out/run.jsonl (sandbox exit $rc)"
    [[ $rc -eq $TIMED_OUT ]] && echo "hutch: the run hit its ${limit}s limit (HUTCH_RUN_TIMEOUT / run_timeout)" >&2
    return "$rc"
  fi
  user_line "$msg" >"$steer"
  SANDBOX_CMD=(timeout -k 30 "$limit" claude -p --input-format stream-json --output-format stream-json --verbose
    --dangerously-skip-permissions)
  (
    set +o pipefail
    sh -c 'echo $$ >"$1"; exec tail -n +1 -f "$2"' _ "$out/tail.pid" "$steer" |
      { sandbox "$task" -i >"$out/run.jsonl" 2>"$out/run.err"; echo $? >"$out/exit.code"; }
  ) &
  local job=$!
  until [[ -s "$out/tail.pid" ]]; do sleep 0.2; done
  tailpid="$(cat "$out/tail.pid")"
  while :; do
    if [[ -f "$out/exit.code" ]] || run_idle "$out/run.jsonl" "$steer"; then break; fi
    sleep 5
  done
  kill "$tailpid" 2>/dev/null || true
  wait "$job" || true
  /bin/rm -f "$out/tail.pid"
  echo "log: $out/run.jsonl (sandbox exit $(cat "$out/exit.code" 2>/dev/null || echo unknown))"
  [[ "$(cat "$out/exit.code" 2>/dev/null)" == "$TIMED_OUT" ]] &&
    echo "hutch: the run hit its ${limit}s limit (HUTCH_RUN_TIMEOUT / run_timeout)" >&2
  [[ "$(cat "$out/exit.code" 2>/dev/null)" == 0 ]]
}

cmd_say() {
  need_task "$1"
  need_models
  need_pro_kind "$1"
  local out; out="$(out_dir "$1")"
  if [[ "$AGENT" == opencode ]]; then
    [[ -f "$out/exit.code" ]] || die "$1 has no finished run; opencode takes a follow-up only after the run stops"
    /bin/rm -f "$out/exit.code"
    SANDBOX_CMD=(timeout -k 30 "$(run_timeout)" opencode run --standalone --auto --format json --continue "$2")
    local rc=0
    sandbox "$1" >>"$out/run.jsonl" 2>>"$out/run.err" || rc=$?
    echo "$rc" >"$out/exit.code"
    echo "follow-up done: $out/run.jsonl (sandbox exit $rc)"
    return "$rc"
  fi
  if ! { [[ -s "$out/tail.pid" ]] && kill -0 "$(cat "$out/tail.pid")" 2>/dev/null; }; then die "no run of $1 is reading messages"; fi
  user_line "$2" >>"$out/steer.jsonl"
  echo "sent to $1"
}

cmd_shell() {
  need_task "$1"
  need_models
  if [[ "$AGENT" == opencode ]]; then SANDBOX_CMD=(opencode --standalone --auto "${@:2}")
  else SANDBOX_CMD=(claude --dangerously-skip-permissions "${@:2}"); fi
  sandbox "$1" -it
}

cmd_export() {
  need_task "$1"
  local dir; dir="$(task_dir "$1")"
  need_image "$PROJECT_IMAGE"
  # git runs in a network-less container, so hooks or config the agent wrote never run on the host.
  docker run --rm --network none --cap-drop ALL -v "$dir/repo:/work:ro" -v "$(out_dir "$1"):/out" \
    -e GIT_CONFIG_NOSYSTEM=1 "$PROJECT_IMAGE" \
    git -c core.hooksPath=/dev/null -c safe.directory=/work bundle create "/out/$1.bundle" "$(cat "$dir/base")..hutch/$1"
}

cmd_verify() {
  need_task "$1"
  local task="$1" dir out base ref bundle heads files f bad=0 tree
  dir="$(task_dir "$task")"; out="$(out_dir "$task")"; base="$(cat "$dir/base")"; ref="refs/hutch/$task"
  bundle="$out/$task.bundle"
  ALLOW_FILE="$dir/allow"; OPENED_FILE="$dir/opened"
  [[ -f "$bundle" ]] || die "no bundle; run hutch export $task"
  # The outcome is kept for hutch report; every failure below goes through vfail.
  vfail() { echo "failed: $*" >"$out/verify.status"; die "$*"; }
  echo "running" >"$out/verify.status"
  git -C "$REPO" bundle verify --quiet "$bundle"
  heads="$(git -C "$REPO" bundle list-heads "$bundle" | awk '$2 ~ /^refs\/heads\// { print $2 }')"
  [[ -n "$heads" && "$(wc -l <<<"$heads")" -eq 1 ]] || vfail "the bundle must hold exactly one branch, has: ${heads:-none}"
  git -C "$REPO" fetch --quiet --no-tags "$bundle" "+$heads:$ref"
  git -C "$REPO" merge-base --is-ancestor "$base" "$ref" || vfail "$ref does not build on $base"
  echo "== commits"; git -C "$REPO" log --oneline "$base..$ref"
  echo "== files"
  files="$(git -C "$REPO" diff --name-only "$base" "$ref")"
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    if protected "$f"; then echo "PROTECTED $f"; bad=1
    elif ! allowed "$f"; then echo "NOT-ALLOWED $f"; bad=1
    else echo "ok $f"; fi
  done <<<"$files"
  echo "== added comment lines"
  git -C "$REPO" diff -U0 "$base" "$ref" -- . ':(exclude)*.md' |
    grep -E '^\+[[:space:]]*(//|/\*|\*|#|--)' | grep -v '^+++' || echo "(none)"
  echo "== test changes"
  local tests_ok=0
  test_changes "$base" "$ref" || tests_ok=1
  [[ $bad -eq 0 ]] || vfail "path check failed"
  [[ $tests_ok -eq 0 ]] || vfail "existing tests were changed and tests_policy=append-only"
  [[ -f "$CONF/verify.sh" ]] || vfail "missing $CONF/verify.sh"
  need_image "$PROJECT_IMAGE"
  # The checks run the agent's code, so they run offline in a fresh container from a plain tree.
  tree="$out/tree"; /bin/rm -rf "$tree"; mkdir -p "$tree"
  git -C "$REPO" archive "$ref" | tar -x -C "$tree"
  printf '%s\n' "$files" >"$out/changed.txt"
  echo "== checks (offline container)"
  local limit rc=0
  limit="$(verify_timeout)"
  offline -v "$tree:/work" -v "$out/changed.txt:/task/changed.txt:ro" -v "$CONF/verify.sh:/task/verify.sh:ro" \
    "$PROJECT_IMAGE" timeout -k 10 "$limit" bash -euo pipefail /task/verify.sh /task/changed.txt 2>&1 |
    tee "$out/verify.log" || rc=$?
  [[ $rc -eq $TIMED_OUT ]] && vfail "checks hit their ${limit}s limit (HUTCH_VERIFY_TIMEOUT / verify_timeout): $out/verify.log"
  [[ $rc -eq 0 ]] || vfail "checks failed: $out/verify.log"
  echo "passed" >"$out/verify.status"
  echo "verify passed: now review the diff yourself: git -C $REPO diff $base $ref"
}

# run_usage sums what the agents' logs in out directory $1 report: opencode step_finish events and Claude Code result
# events, over every phase's log (run.jsonl and the run.<time>.jsonl files an earlier phase left).
run_usage() {
  python3 -I - "$1" <<'EOF'
import glob, json, os, sys
logs = sorted(glob.glob(os.path.join(sys.argv[1], "run*.jsonl")))
if not logs:
    print("no run logs")
    sys.exit(0)
t = dict(input=0, output=0, reasoning=0, read=0, write=0)
cost = 0.0
secs = 0.0
for log in logs:
    first = last = None
    for line in open(log, errors="replace"):
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if not isinstance(e, dict):
            continue
        ts = e.get("timestamp")
        if isinstance(ts, (int, float)):
            first = ts if first is None else first
            last = ts
        part = e.get("part") or {}
        if e.get("type") == "step_finish" or part.get("type") == "step-finish":
            k = part.get("tokens") or {}
            c = k.get("cache") or {}
            t["input"] += k.get("input", 0); t["output"] += k.get("output", 0); t["reasoning"] += k.get("reasoning", 0)
            t["read"] += c.get("read", 0); t["write"] += c.get("write", 0)
            cost += part.get("cost") or 0
        elif e.get("type") == "result":
            u = e.get("usage") or {}
            t["input"] += u.get("input_tokens", 0); t["output"] += u.get("output_tokens", 0)
            t["read"] += u.get("cache_read_input_tokens", 0); t["write"] += u.get("cache_creation_input_tokens", 0)
            cost += e.get("total_cost_usd") or 0
            secs += (e.get("duration_ms") or 0) / 1000
    if first is not None and last is not None:
        secs += (last - first) / 1000
print("tokens: input %(input)d, output %(output)d, reasoning %(reasoning)d, cache read %(read)d, cache write %(write)d" % t
      + "; cost reported %.2f; agent time %ds" % (cost, secs))
EOF
}

# cmd_report prints one task's outcome for the reviewer and keeps it as report.md: model, exit code, usage, commits,
# verify status, test changes and the files to read. It reads git only in the host repository, never in the agent's
# clone, so it lists commits after hutch export and hutch verify.
cmd_report() {
  need_task "$1"
  local task="$1" dir out base ref
  dir="$(task_dir "$task")"; out="$(out_dir "$task")"; base="$(cat "$dir/base")"; ref="refs/hutch/$task"
  {
    echo "# hutch report: $task"
    echo
    echo "- project: $NAME ($REPO)"
    echo "- base: $base"
    echo "- runs:"
    if [[ -s "$out/models.log" ]]; then sed 's/^/  - /' "$out/models.log"; else echo "  - none"; fi
    echo "- run exit code: $(cat "$out/exit.code" 2>/dev/null || echo 'none')"
    echo "- $(run_usage "$out")"
    echo "- verify: $(cat "$out/verify.status" 2>/dev/null || echo 'not run')"
    echo
    if git -C "$REPO" rev-parse --verify --quiet "$ref" >/dev/null; then
      echo "## Commits"
      echo
      git -C "$REPO" log --format='- %h %s' "$base..$ref"
      echo
      echo "## Diff"
      echo
      echo '```'
      git -C "$REPO" diff --stat "$base" "$ref"
      echo '```'
      echo
      echo "## Test changes"
      echo
      test_changes "$base" "$ref" | sed 's/^/- /' || true
    else
      echo "No commits on the host yet: run hutch export $task, then hutch verify $task."
    fi
    echo
    echo "## To review"
    echo
    local f
    for f in self-review.md design-notes.md verify.log run.err gate.log; do
      [[ -s "$out/$f" ]] && echo "- $out/$f"
    done
    echo "- git -C $REPO diff $base $ref"
  } | tee "$out/report.md"
}

# Isolation probes inside the same sandbox the agent gets. Prints names, never the key's value.
cmd_isolation() {
  need_task "$1"
  need_models
  SANDBOX_CMD=(bash -c '
    probe() { if timeout 8 bash -c "$2" >/dev/null 2>&1; then echo "REACHABLE $1"; else echo "blocked $1"; fi; }
    echo "== egress"
    code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 15 "$HUTCH_PROBE_URL" -X POST -d "{}")
    echo "model API via gate http=$code"
    code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 6 "$HUTCH_GATE/")
    echo "other gate path http=$code"
    for u in https://github.com https://proxy.golang.org https://registry.npmjs.org https://pypi.org https://api.anthropic.com https://1.1.1.1; do
      probe "direct $u" "curl -sf --max-time 6 $u"; done
    probe "dns github.com" "getent hosts github.com"
    gw=$(ip route 2>/dev/null | awk "/default/{print \$3}"); gw=${gw:-172.17.0.1}
    for p in 22 80 2375 2376 3306 4222 5432 6379 6380 8222 27017; do
      probe "host.docker.internal:$p" "echo > /dev/tcp/host.docker.internal/$p"
      probe "gateway:$p" "echo > /dev/tcp/$gw/$p"; done
    echo "== identity and mounts"
    id
    grep -vE " (proc|sysfs|cgroup2?|mqueue|devpts|tmpfs|overlay|shm) " /proc/mounts | awk "{print \$2}"
    for d in .ssh .kube .aws .config/gh .docker .pgpass .netrc; do [ -e "$HOME/$d" ] && echo "PRESENT ~/$d"; done
    ls /var/run/docker.sock 2>/dev/null && echo "PRESENT docker.sock"
    echo "== env names"; env | cut -d= -f1 | sort | tr "\n" " "; echo
    if [ "${ANTHROPIC_AUTH_TOKEN:-hutch-gate}${OPENCODE_API_KEY:-hutch-gate}" = hutch-gatehutch-gate ]; then
      echo "provider key: not in the sandbox (placeholder only)"; else echo "PRESENT provider key"; fi
    echo "== capabilities"; grep CapEff /proc/self/status
  ')
  sandbox "$1" -i
}

cmd_smoke() {
  need_task "$1"
  need_models
  if [[ "$AGENT" == opencode ]]; then SANDBOX_CMD=(opencode run --standalone --format json "Reply with exactly: OK")
  else SANDBOX_CMD=(claude -p "Reply with exactly: OK" --output-format json); fi
  # stdin closed: with -i and an open pipe (an agent's shell), opencode run waits on stdin forever.
  sandbox "$1" -i </dev/null
}

cmd_rm() {
  [[ "${1:-}" =~ ^[a-z0-9-]+$ ]] || die "task name must match [a-z0-9-]+"
  /bin/rm -rf "$(task_dir "$1")" "$(out_dir "$1")"
  git -C "$REPO" update-ref -d "refs/hutch/$1" 2>/dev/null || true
}

cmd_models() {
  echo "provider $PROVIDER ($MODELS_FILE):"
  grep -v '^#' "$MODELS_FILE"
  echo "skipped (${HUTCH_HOME}/skip):"
  cat "${HUTCH_HOME}/skip" 2>/dev/null || true
}

usage() { sed -n '2,/^# Agents:/p' "${HUTCH_DIR}/hutch"; }

# All code lives in functions and main runs last, so bash has parsed the whole file before anything executes: a git
# pull that rewrites this file during a long run cannot change the running command.
main() {
  setup_provider
  [[ $# -gt 0 ]] || { usage; exit 2; }
  local cmd="$1"; shift
  case "$cmd" in
    status) cmd_status ;;
    models) cmd_models ;;
    help|-h|--help) usage ;;
    init) cmd_init "${1:-}" ;;
    build) cmd_build ;;
    *)
      need_project
      case "$cmd" in
        new) [[ $# -eq 3 ]] || die "usage: hutch new <task> <allow-file> <brief-file>"; cmd_new "$@" ;;
        run) cmd_run "${1:-}" ;;
        say) [[ $# -eq 2 ]] || die "usage: hutch say <task> <message>"; cmd_say "$@" ;;
        shell) cmd_shell "$@" ;;
        export) cmd_export "${1:-}" ;;
        verify) cmd_verify "${1:-}" ;;
        rm) cmd_rm "${1:-}" ;;
        isolation) cmd_isolation "${1:-}" ;;
        smoke) cmd_smoke "${1:-}" ;;
        report) cmd_report "${1:-}" ;;
        needs-pro) need_task "${1:-}"; needs_pro "$(task_dir "$1")/allow" "$(task_dir "$1")/opened" ;;
        *) usage; exit 2 ;;
      esac ;;
  esac
}

[[ "${HUTCH_LIB:-}" == 1 ]] || main "$@"

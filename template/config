# hutch project config: key=value lines, read by hutch (never executed); hutch init appends name= and repo=.
# The branch new tasks clone, and the branch build reads dependency manifests from.
base_branch=main
# ERE of the dependency manifests copied into the image build (from the base branch), so the image can warm its
# caches. Leave empty when the Dockerfile needs no project files.
manifests=
# Container path of a persistent cache volume shared by this project's tasks (for example a build cache). Optional.
cache_mount=
# Sandbox limits, for the agent's run and for hutch verify's checks (they run the agent's code).
memory=12g
pids=2048
# Docker runtime for the sandbox, verify's checks and export, for example runsc (gVisor: a user-space kernel between
# the agent's code and the host's). Empty: Docker's default. It must be installed (AGENTS.md, gVisor).
runtime=
# Test files, an ERE over repository paths; empty uses hutch's default (test/, __tests__/, *.test.*, *_test.go,
# test_*.py and similar). hutch verify names deleted test files, lines removed from existing tests and new skip or
# focus markers. tests_policy=report only names them; append-only also fails verify.
tests=
tests_policy=report
# Wall-clock limits in seconds: a run (and each hutch say follow-up), and the checks of hutch verify.
run_timeout=3600
verify_timeout=1800

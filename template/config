# hutch project config: key=value lines, read by hutch (never executed); hutch init appends name= and repo=.
# The branch new tasks clone, and the branch build reads dependency manifests from.
base_branch=main
# ERE of the dependency manifests copied into the image build (from the base branch), so the image can warm its
# caches. Leave empty when the Dockerfile needs no project files.
manifests=
# Container path of a persistent cache volume shared as a read-only base with an ephemeral CoW overlay per task. Optional.
cache_mount=
# Read-only host dependency/cache overlays mounted with ephemeral per-run CoW upper layers (never mutating the host).
# Space-separated host_path:container_path pairs (relative host paths resolve from repo root; ~/ expands to $HOME).
# Example: cache_overlays=node_modules:/work/node_modules ~/.cache/go-build:/cache/go-build
cache_overlays=
# Overlay implementation: auto (docker-overlay on Linux with cow-tmpfs fallback; cow-tmpfs on macOS), docker-overlay, cow-tmpfs, ro.
cache_overlay_mode=auto
# Sandbox limits, for the agent's run and for hutch verify's checks (they run the agent's code).
memory=12g
pids=2048
# Docker runtime for the sandbox, verify's checks and export, for example runsc (gVisor: a user-space kernel between
# the agent's code and the host's). Empty: Docker's default. It must be installed (AGENTS.md, gVisor).
runtime=
# Test files, an ERE over repository paths; empty uses hutch's default (test/, __tests__/, *.test.*, *_test.go,
# test_*.py and similar). hutch verify names deleted test files, lines removed from existing tests and new skip or
# focus markers. tests_policy=report only names them; append-only also fails verify.
tests=
tests_policy=report
# Path scoping mode for hutch verify: strict (default: fail on any file outside allow) or soft (warn with
# WARN: UNSCOPED_PATHS on non-protected files outside allow). Hard-protected files always fail, pre-existing tests fail
# unless --allow-tests is passed, and files matching pro-paths fail unless every run of the task used a strong kind.
scope_mode=strict
# Wall-clock limits in seconds: a run (and each hutch say follow-up), and the checks of hutch verify.
run_timeout=3600
verify_timeout=1800
# Mid-flight watchdog defaults: max_turns (empty or 0 = unlimited), loop_threshold (consecutive identical failures; 0 disables).
max_turns=
loop_threshold=3
